 :root {\n            --bg-color: #f4f1ee; /* Warm Off-White */\n            --text-color: #5a5349; /* Warm Gray/Brown Body Text */\n            --heading-color: #4a433a; /* Darker Warm Gray/Brown Headings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        .container {\n            width: 100%;\n            padding: 0 20px;\n            box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400;\n            color: var(--text-color);\n        }\n        b, strong {\n            font-weight: 700;\n            color: var(--heading-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n            background-image: url('/img/project/luxuria/4u0a6730a.avif'); \n            background-size: cover;\n            background-position: center center;\n            position: relative; \n            overflow: hidden;\n            min-height: 400px;\n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1;\n        }\n        \n        .hero-section::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(30px, 5.5vw, 54px);\n            font-weight: 700;\n            margin-bottom: 0;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .intro-text h2 {\n            font-size: clamp(26px, 3.5vw, 36px);\n            margin-bottom: 20px;\n            color: var(--heading-color);\n            line-height: 1.25;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width,\n        .service-card:nth-child(3),\n        .service-card:nth-child(4) {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n        }\n        .service-card h3 {\n            font-size: 24px;\n            margin-bottom: 15px;\n            color: var(--heading-color);\n        }\n        .service-card p {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 10px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n        .service-card ul {\n            padding-left: 20px;\n            margin: 10px 0;\n        }\n        .service-card li {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 6px;\n            color: var(--text-color);\n        }\n\n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            margin-bottom: 50px;\n        }\n        .why-choose-us h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--accent-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px;\n            font-size: 16px;\n        }\n        .why-choose-intro p {\n            margin-bottom: 10px;\n        }\n        .reason-list {\n            list-style: none;\n            padding: 0;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n        }\n        .reason-list li {\n            background: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border-left: 5px solid var(--accent-color);\n            font-size: 15px;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n            color: var(--heading-color);\n        }\n        .final-cta-message {\n            margin-top: 30px;\n            text-align: center;\n            font-style: italic;\n            font-size: 15px;\n            color: var(--heading-color);\n        }\n        .final-cta-message a {\n            color: var(--accent-color);\n            text-decoration: underline;\n            font-weight: 600;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            margin-bottom: 50px;\n        }\n        .faq-section h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 30px;\n            color: var(--accent-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-bottom: 15px;\n        }\n        .faq-q {\n            font-size: 18px;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 20px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            padding: 14px 38px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(139, 129, 115, 0.3);\n            letter-spacing: 0.5px;\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(74, 67, 58, 0.4);\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Best Salon Interior Designer in Rajokri, Delhi</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            <h2>Premium Salons for the Airport Corridor</h2>\n            <p>As the best salon interior designer in Rajokri, Delhi, we create spaces that reflect your brand identity, impress clients from the moment they walk in, and enhance overall workflow efficiency. Our designs combine luxury aesthetics with operational functionality to ensure a modern, welcoming, and stylish salon experience for both your clients and your staff.</p>\n            <p>Rajokri's location near Vasant Kunj, Aerocity and the Gurgaon border puts it within reach of clients who are used to high-end salons. Owners who want the best salon interior designer for this market need a space that feels polished and calm, and a layout that keeps a busy team moving smoothly.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Stylish and Functional Salon Interiors</h2>\n            <p>\"From luxury spas to boutique hair studios, we craft unique interiors that maximize floor space, enhance the customer journey, and optimize daily operations. Through smart layouts, ergonomic stations, and brand-specific décor, we elevate your salon to a destination status in Rajokri.\"</p>\n        </div>\n\n        <!-- SERVICE CATEGORIES GRID (4 CARDS) -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Luxury Hair and Beauty Lounges</h3>\n                <p>For a premium lounge, we keep the number of stations modest and give each one generous space, a quality chair and its own lighting. A separate colour bar, a quiet wash lounge with reclining basins and a private treatment room add to the sense of luxury.</p><p>Materials such as veneer, marble-look surfaces and brushed metal give a rich finish that is still easy to clean.</p><p>Retail shelves near the exit invite clients to pick up the products their stylist just used.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Salons Attached to Farmhouses and Venues</h3>\n                <p>Some wedding venues and farmhouses now include a salon for brides and guests. The best salon interior designer plans these rooms for heavy use on event days, with several makeup stations, plenty of power points, a steamer area for outfits and direct access from the parking.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Lighting, Sound and Scent</h3>\n                <p>Clients remember how a salon feels. We plan bright, accurate light at the mirrors and softer light in waiting and wash areas. Background music is zoned so it does not compete with conversation. Good exhaust near the colour bar keeps the air fresh, so the salon smells clean rather than of chemicals.</p><p>Hidden storage keeps product boxes out of sight.</p><p>Flooring near the basins is slip-resistant, and a hidden drain under the backwash units makes cleaning quick.</p><p><b>Workflow Optimization:</b> Strategic floor planning that minimizes staff steps and ensures a seamless transition between styling, washing, and treatment areas.</p><p><b>Bespoke Furniture:</b> The best salon interior designer curates ergonomic and stylish furniture that provides maximum comfort for clients while maintaining a high-end visual appeal.</p><p><b>Ambient Lighting:</b> Specialized lighting solutions that offer perfect visibility for stylists while creating a relaxing, flattering ambiance for clients.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Getting From Idea to Opening</h3>\n                <p>We start with your brand, service menu and price range, then visit the space. As the best salon interior designer for your goals, we prepare two layout options and 3D views, and suggest where to invest for the biggest effect.</p><p>Site work covers plumbing, electricals, ceilings, furniture, lighting and branding, scheduled to meet your launch date.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>What Makes Us the Best Salon Interior Designer for Your Project</h2>\n            <div class=\"why-choose-intro\">\n                <p>We design salons as working spaces first. Stylists, therapists and front-desk staff are consulted before the layout is locked. Their feedback often saves costly changes later.</p>\n            </div>\n            <ul class=\"reason-list\">\n                <li>\n                    <strong>Experts in High-End Commercial Salon & Spa Design</strong>\n                    Experience with premium salons, spas and bridal rooms.\n                </li>\n                <li>\n                    <strong>Tailored Solutions for Brand and Operational Needs</strong>\n                    Brand look and daily operations planned together.\n                </li>\n                <li>\n                    <strong>End-to-End Execution for Stress-Free Transformation</strong>\n                    Complete service from drawings to a ready salon.\n                </li>\n                <li>\n                    <strong>Event-Day Ready Layouts</strong>\n                    Rooms that cope with many guests at once.\n                </li>\n                <li>\n                    <strong>Fresh Air by Design</strong>\n                    Exhaust and airflow that keep chemical smells down.\n                </li>\n            </ul>\n            <div class=\"final-cta-message\">\n                <p>Ready to create a space that beauty enthusiasts will love? Partner with Rajokri's top salon interior specialists to bring your vision to life.</p>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects Near Rajokri</h2>\n                <p>Recent interiors from our portfolio in Gurgaon, Saket and South Extension.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                    <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-virend-singh-gurgaon/mr-virend-singh-gurgaon/final-render-04.avif\" alt=\"Architecture and interiors by 9th Corner in Gurgaon\" title=\"Gurgaon Project\">\n                            </div>\n                        </div>\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-alok-verma-south-x/mr-alok-verma-south-x/7