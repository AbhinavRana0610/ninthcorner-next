      left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4); \n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(36px, 8vw, 68px);\n            font-weight: 700;\n            margin-bottom: 10px;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n        .hero-section p {\n            font-size: clamp(16px, 3vw, 24px);\n            font-weight: 600;\n            color: var(--bg-color);\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card {\n            background-color: #ffffff; \n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s, box-shadow 0.3s;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);\n        }\n        .service-card h3 {\n            color: var(--accent-color);\n            font-size: 26px;\n            margin-bottom: 10px;\n        }\n        \n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            padding: 40px 0;\n        }\n        .why-choose-us h2 {\n            text-align: center;\n            font-size: 40px;\n            margin-bottom: 40px;\n            color: var(--heading-color);\n        }\n        .reason-list {\n            display: flex;\n            justify-content: space-around;\n            flex-wrap: wrap;\n            padding: 0;\n            list-style: none;\n            max-width: 900px;\n            margin: 0 auto 40px auto;\n        }\n        .reason-list li {\n            background-color: var(--accent-color);\n            color: var(--bg-color);\n            padding: 15px 25px;\n            margin: 10px;\n            border-radius: 50px;\n            font-weight: 700;\n            box-shadow: var(--shadow-subtle);\n            transition: background-color 0.3s;\n        }\n        .reason-list li:hover {\n            background-color: #6d655a;\n        }\n        .final-cta-message {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto;\n            font-size: 1.1em;\n            font-weight: 600;\n            color: var(--heading-color);\n            border-top: 2px solid var(--accent-color);\n            padding-top: 30px;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Farmhouse Interior Designer in Rajokri, Delhi</h1>\n            <p>Rustic Charm Meets Modern Luxury</p>\n        </div>\n    </section>\n\n    <div class=\"container content-wrap\">\n\n        <div class=\"intro-text\">\n            <p>We specialize in farmhouse interiors that blend rustic charm with contemporary comfort. As a farmhouse interior designer in Rajokri, Delhi, we focus on creating relaxing, elegant, and functional retreats that harmonize with nature while providing modern amenities. We turn expansive properties into soulful sanctuaries where luxury feels grounded and timeless.</p>\n        </div>\n\n        <div class=\"philosophy-box\">\n            <h2>Personalized Farmhouse Interiors</h2>\n            <p>\"We design cozy living areas, open kitchens, master suites, and outdoor lounges that reflect your lifestyle. By incorporating large windows, earthy tones, natural stone, and seamless indoor-outdoor transitions, we create farmhouses that are as inviting as they are impressive.\"</p>\n        </div>\n\n        <div class=\"services-grid\">\n            \n            <div class=\"service-card\">\n                <h3>Rustic-Modern Fusion</h3>\n                <p>Expertly balancing raw architectural elements like reclaimed wood and exposed stone with sleek, high-end modern furniture.</p>\n            </div>\n            \n            <div class=\"service-card\">\n                <h3>Spacious Layouts</h3>\n                <p>A farmhouse interior designer creates airy, open-concept floor plans that prioritize natural light and provide a sense of unlimited freedom within the home.</p>\n            </div>\n\n            <div class=\"service-card\">\n                <h3>Nature-Integrated Design</h3>\n                <p>Creating a dialogue between the interior and the landscape through strategic window placement and organic material palettes.</p>\n            </div>\n\n        </div>\n\n        <section class=\"why-choose-us\">\n            <h2>Why Choose Us</h2>\n            <ul class=\"reason-list\">\n                <li>Expertise in Luxury Farmhouse & Countryside Projects</li>\n                <li>Customized Interiors Based on Your Specific Lifestyle</li>\n                <li>End-to-End Project Management from Concept to Delivery</li>\n            </ul>\n            <p class=\"final-cta-message\">\n                Ready to create your perfect escape? Partner with the leading farmhouse interior specialists in Rajokri, Delhi, and watch your dream retreat come to life.\n            </p>\n        </section>\n\n        <!-- FAQS:auto -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Why hire a farmhouse interior designer in Rajokri?</h3>\n                    <p class=\"faq-a\">Rajokri has many farmhouses used as homes and for events. A specialist plans large spaces so they feel warm, work for gatherings and stay easy to maintain.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can a farmhouse be designed for weddings and events?</h3>\n                    <p class=\"faq-a\">Yes. We plan lawns, outdoor lighting, guest areas, washrooms and service routes so events run smoothly while the main house stays private.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What style suits a Rajokri farmhouse?</h3>\n                    <p class=\"faq-a\">Most clients like a mix of modern comfort and natural materials, with open living spaces that lead to lawns and verandas.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What does a farmhouse interior designer plan for maintenance?</h3>\n                    <p class=\"faq-a\">Durable floors, washable fabrics, enough storage and easy access to services keep a large farmhouse simple to look after.</p>\n                </div>\n            </div>\n        </section>\n        <!-- /FAQS:auto -->\n\n    </div>\n"}