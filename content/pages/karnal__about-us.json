{"route":"/karnal/about-us.php","city":"karnal","nested":false,"meta":{"og":{"type":"website","site_name":"9th-Corner","title":"About Us | Interior Design Firm in Karnal | 9th Corner","description":"Meet 9th Corner, the interior design firm serving Karnal for 22 years. Learn about our design philosophy, our team and 800+ spaces delivered.","url":"https://www.ninthcorner.in/karnal/about-us.php","image":"https://www.ninthcorner.in/img/og-default.jpg","image:width":"1200","image:height":"630"},"twitter":{"card":"summary_large_image","title":"About Us | Interior Design Firm in Karnal | 9th Corner","description":"Meet 9th Corner, the interior design firm serving Karnal for 22 years. Learn about our design philosophy, our team and 800+ spaces delivered.","image":"https://www.ninthcorner.in/img/og-default.jpg"},"title":"About Us | Interior Design Firm in Karnal | 9th Corner","robots":"index, follow","author":"9th-Corner","publisher":"9th-Corner","google-site-verification":"bFDxjFr1uDW3hEQ7YEzagKY9ZLzkrW1k1vtMcyQahyE","description":"Meet 9th Corner, the interior design firm serving Karnal for 22 years. Learn about our design philosophy, our team and 800+ spaces delivered.","keywords":"Architecture firm Karnal, About architecture company, Best architects Karnal, Modern architectural services in Karnal,","theme-color":"#0f141f","canonical":"https://www.ninthcorner.in/karnal/about-us.php"},"jsonLd":["{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://www.ninthcorner.in/#organization\",\"name\":\"9th Corner\",\"alternateName\":[\"Ninth Corner\",\"9th-Corner\"],\"url\":\"https://www.ninthcorner.in/\",\"image\":\"https://www.ninthcorner.in/img/logo.avif\",\"logo\":\"https://www.ninthcorner.in/img/logo.avif\",\"description\":\"Learn about our architecture firm in Karnal offering innovative, sustainable, and client-focused architectural solutions for homes, offices, commercial buildings, and more.\",\"telephone\":\"+91-9310582834\",\"email\":\"ninthcorner83@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Pearls Best Heights I, 808, Netaji Subhash Place, Pitampura\",\"addressLocality\":\"Delhi\",\"postalCode\":\"110034\",\"addressRegion\":\"Delhi\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Karnal\"},\"sameAs\":[\"https://www.facebook.com/ninthcornerINC\",\"https://www.instagram.com/9thcorner.interiors/\",\"https://www.linkedin.com/company/9th-corner-int/\",\"https://youtube.com/@9thcorner\"]}","{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.ninthcorner.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Karnal\",\"item\":\"https://www.ninthcorner.in/karnal/index.php\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"About Us\",\"item\":\"https://www.ninthcorner.in/karnal/about-us.php\"}]}","{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.ninthcorner.in/#website\",\"name\":\"9th Corner\",\"alternateName\":\"Ninth Corner\",\"url\":\"https://www.ninthcorner.in/\",\"publisher\":{\"@id\":\"https://www.ninthcorner.in/#organization\"}}"],"preloads":[],"html":"\n\n     <style>\n        /* Basic Reset and Body Styles */\n        body {\n            margin: 0;\n            /* font-family: 'Poppins', sans-serif; */\n            background-color: #fdfdfd;\n            overflow-x: hidden;\n            color: #333;\n            line-height: 1.7;\n        }\n\n       .banner-section1, .projects-grid-section {\n            position: relative;\n            width: 100%;\n            scroll-behavior: smooth; \n        }\n\n        /* --- Banner Section (Parallax) --- */\n        .banner-section1 {\n            height: 70vh;\n            /* Placeholder image (must be a URL since local files are not supported) */\n            background-image: url('/img/about.avif');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed; /* CRITICAL for Parallax on desktop */\n            \n            box-shadow: inset 0 -10px 10px rgba(0, 0, 0, 0.2); \n\n            display: flex; \n            justify-content: center;\n            align-items: flex-end;\n            padding-bottom: 30px;\n        }\n\n        /* Fallback for better mobile compatibility/performance */\n        @media (max-width: 640px) {\n            .banner-section1 {\n                       background-attachment: scroll;\n      height: 35dvh;\n        background-size: cover;\n            }\n        }\n\n        /* Dark overlay for readability */\n        .banner-section1::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            bottom: 0;\n            left: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n        }\n        \n        /* --- Scroll Down Indicator Styling --- */\n        .scroll-indicator {\n            color: white;\n            font-size: 1rem;\n            font-weight: 600;\n            text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            opacity: 0.8;\n            cursor: pointer;\n            transition: opacity 0.3s;\n            z-index: 10; \n        }\n\n        .scroll-indicator:hover {\n            opacity: 1;\n        }\n\n        .scroll-indicator svg {\n            width: 30px;\n            height: 30px;\n            fill: white;\n            animation: bounce 1.5s infinite;\n        }\n\n        /* Bouncing animation for the indicator */\n        @keyframes bounce {\n            0%, 20%, 50%, 80%, 100% {\n                transform: translateY(0);\n            }\n            40% {\n                transform: translateY(-10px);\n            }\n            60% {\n                transform: translateY(-5px);\n            }\n        }\n        \n        .bg-light {\n            background-color: #f8f8f8;\n        }\n\n          .scroll-h{\n                  display: flex\n;\n    max-width: 70%;\n    transform: translate(10px, -114px);\n    text-align: center;\n\n        }\n\n        .scroll-h h1{\n            color: #212121;\n            font-size: 2.7rem;\n\n        }\n\n\n        /* Container for Centering Content */\n        .container {\n            max-width: 1100px;\n            margin-left: auto;\n            margin-right: auto;\n            padding-left: 1.5rem;\n            padding-right: 1.5rem;\n            text-align: center;\n        }\n\n        /* Typography */\n        h1, h3 {\n            font-family: 'Playfair Display', serif;\n            font-weight: 700;\n            margin-top: 0;\n            color: #1a1a1a;\n        }\n        \n        h2 {\n            font-size: 2.75rem;\n            margin-bottom: 1rem;\n        }\n        \n        h3 {\n            font-size: 1.5rem;\n            margin-bottom: 0.5rem;\n        }\n\n        p {\n            font-size: 1rem;\n            /* max-width: 750px; */\n            margin-left: auto;\n            margin-right: auto;\n            margin-bottom: 1.5rem;\n            font-weight: 300;\n        }\n        \n        .subheading {\n            font-size: 1.1rem;\n            color: #888;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            margin-bottom: 2rem;\n        }\n        \n        /* Team Section Layout */\n        .team-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2.5rem;\n            margin-top: 3rem;\n        }\n\n        .team-member {\n            text-align: center;\n        }\n\n        .team-member img {\n            width: 150px;\n            height: 150px;\n            border-radius: 50%;\n            object-fit: cover;\n            margin-bottom: 1rem;\n            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);\n        }\n        \n        .team-member .role {\n             color: #777;\n             font-style: italic;\n        }\n\n\n        /* Responsive Design */\n        @media (min-width: 768px) {\n            .team-grid {\n                grid-template-columns: repeat(4, 1fr);\n            }\n            .content-section {\n                padding: 7rem 0;\n            }\n             h2 {\n                font-size: 3.5rem;\n            }\n            p {\n                font-size: 1.1rem;\n            }\n        }\n\n         @media screen and (min-width: 320px) and (max-width: 500px){\n            .scroll-h h1 {\n           color: #212121;\n               font-size: 18px;\n        padding: 25px;\n}\n\n.scroll-h {\n    display: flex\n;\n    max-width: 100%;\n    transform: translate(0px, 0px);\n    text-align: center;\n}\n\n.philosophy-section .section-title{\n    font-size: 24px;\n}\n.team-section .section-title{\n    font-size: 24px;\n}\n\n.container{\n    margin-top:0px !important;\n}\n         }\n    </style>\n\n\n\n   <section class=\"banner-section1\">\n        <div class=\"scroll-indicator\" onclick=\"document.querySelector('.projects-grid-section').scrollIntoView({ behavior: 'smooth' });\">\n             <div class=\"scroll-h\">\n                <h1>We go beyond walls and furniture &mdash; creating interiors that feel like home and inspire every day.</h1>\n    </div>\n            <!-- <p>Scroll Down</p> -->\n            <svg viewBox=\"0 0 24 24\">\n                <path d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\"/>\n            </svg>\n        </div>\n    </section>\n\n    <!-- Philosophy Section -->\n    <section class=\"philosophy-section content-section\">\n        <div class=\"container\">\n            <h2 class=\"section-title\">TOP INTERIOR DESIGN FIRM</h2>\n            <p class=\"subheading\">Top Interior Design, Best Architecture And Best Scientific Vastu Firm in India: Crafting Stories Behind Every Space</p>\n            <p class=\"section-content\">\n               We are proud to be recognized as the top interior design firm in India, trusted by homeowners and businesses alike. Our strength lies in our approach, combining creativity and functionality to create environments that are beautiful to live in and work in. We will take your space from ordinary to extraordinary and create inspirational spaces using our years of experience and a committed team of designers, architects, and artisans. Lastly, what sets us apart from other design firms is our ability to capture your lifestyle and turn it into a design that is really &ldquo;you.&rdquo;\n            </p>\n        </div>\n    </section>\n\n    <!-- Team Section -->\n    <section class=\"team-section content-section bg-light\">\n        <div class=\"container\">\n            <h2 class=\"section-title\">Meet Our Creative Team</h2>\n            <p class=\"subheading\">The Visionaries Behind the Designs</p>\n            <div class=\"team-grid\">\n                <!-- Team Member 1 -->\n                <div class=\"team-member\">\n                    <img width=\"2560\" height=\"1945\" decoding=\"async\" src=\"/img/pro3.avif\" alt=\"Mamta Verma - Manager\" title=\"Mamta Verma - Manager\">\n                    <h3> Mamta Verma</h3>\n                    <p class=\"role\"> Manager</p>\n                </div>\n                <!-- Team Member 2 -->\n                <div class=\"team-member\">\n                    <img width=\"1648\" height=\"2500\" decoding=\"async\" loading=\"lazy\" src=\"/img/pro2.avif\" alt=\"Ibaanca Kapoor - Interior Designer\" title=\"Ibaanca Kapoor - Interior Designer\">\n                    <h3>Ibaanca Kapoor</h3>\n                    <p class=\"role\">Interior designer</p>\n                </div>\n                <!-- Team Member 3 -->\n                <div class=\"team-member\">\n                    <img width=\"986\" height=\"986\" decoding=\"async\" loading=\"lazy\" src=\"/img/pro1.avif\" alt=\"Khushi Rai - Interior Designer\" title=\"Khushi Rai - Interior Designer\">\n                    <h3>Khushi Rai</h3>\n                    <p class=\"role\">Interior designer</p>\n                </div>\n                <!-- Team Member 4 -->\n                <div class=\"team-member\">\n                    <img width=\"2560\" height=\"2560\" decoding=\"async\" loading=\"lazy\" src=\"/img/pro4.avif\" alt=\"Mudassir - Design Visualizer\" title=\"Mudassir - Design Visualizer\">\n                    <h3> Mudassir</h3>\n                    <p class=\"role\">3D Visualiser</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // --- PARALLAX & ANIMATION ---\n\n            // 1. Hero background parallax\n            gsap.to(\".hero-section\", {\n                backgroundPosition: `50% ${window.innerHeight / 2.5}px`,\n                ease: \"none\",\n                scrollTrigger: {\n                    trigger: \".hero-section\",\n                    start: \"top top\",\n                    end: \"bottom top\",\n                    scrub: true\n                }\n            });\n\n            // 2. Animate sections as they appear\n            const sections = gsap.utils.toArray('.content-section');\n            sections.forEach(section => {\n                // Animate the title\n                gsap.from(section.querySelector('.section-title'), {\n                    scrollTrigger: { trigger: section, start: \"top 80%\" },\n                    duration: 1.2,\n                    y: 50,\n                    opacity: 0,\n                    ease: \"power3.out\"\n                });\n                \n                // Animate subheading and content\n                gsap.from([section.querySelector('.subheading'), section.querySelector('.section-content')], {\n                    scrollTrigger: { trigger: section, start: \"top 75%\" },\n                    duration: 1.2,\n                    y: 30,\n                    opacity: 1,\n                    ease: \"power3.out\",\n                    delay: 0.2\n                });\n            });\n            \n            // 3. Staggered animation for team members\n            gsap.from('.team-member', {\n                scrollTrigger: {\n                    trigger: \".team-grid\",\n                    start: \"top 85%\"\n                },\n                duration: 1,\n                y: 50,\n                opacity: 1,\n                stagger: 0.2,\n                ease: \"power3.out\"\n            });\n        });\n    </script>\n"}