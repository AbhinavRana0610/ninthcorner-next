  margin: 0 auto;\n               padding: 54px 1rem;\n        }\n\n        /* --- Section Header --- */\n        .section-header {\n            text-align: center;\n            margin-bottom: 4rem;\n                margin-top: 60px;\n        }\n\n        .heading-main {\n            font-size: 3rem; /* 5xl equivalent */\n            font-weight: 700;\n            margin-bottom: 1rem;\n            letter-spacing: -0.05em;\n        }\n\n        .subheading {\n            font-size: 1.25rem; /* xl equivalent */\n            font-weight: 600;\n            max-width: 48rem;\n            margin: 0 auto;\n            color: var(--accent-color);\n        }\n\n        /* --- Card Grid Layout --- */\n        .grid-container {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2.5rem; /* gap-10 equivalent */\n        }\n\n        /* Responsive grid columns */\n        @media (min-width: 768px) { /* md breakpoint */\n            .grid-container {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (min-width: 1024px) { /* lg breakpoint */\n            .grid-container {\n                grid-template-columns: repeat(3, 1fr);\n            }\n        }\n\n        /* --- Blog Card Styles (renamed to .card) --- */\n        .card {\n            background-color: white;\n            border: 1px solid rgba(139, 129, 115, 0.3);\n            border-radius: 0.75rem; /* rounded-xl */\n            overflow: hidden;\n            box-shadow: 0 4px 6px -1px rgba(74, 67, 58, 0.1), 0 2px 4px -2px rgba(74, 67, 58, 0.05); /* Soft shadow */\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            cursor: pointer; /* Added cursor style to indicate clickability */\n        }\n\n        .card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 10px 15px -3px rgba(74, 67, 58, 0.1), 0 4px 6px -2px rgba(74, 67, 58, 0.05);\n        }\n\n        .card-image {\n            wi