ols span {\n            width: 12px;\n            height: 12px;\n            border-radius: 50%;\n            background-color: #e0e0e0;\n        }\n\n        /* --- Vertical Navigation --- */\n        .vertical-nav {\n            position: fixed;\n            top: 50%;\n            left: 20px;\n            transform: translateY(-50%);\n            z-index: 10;\n        }\n\n        .vertical-nav ul {\n            list-style: none;\n            padding: 0;\n            margin: 0;\n            transform: rotate(-90deg);\n            transform-origin: left top;\n            display: flex;\n            gap: 30px;\n        }\n        \n        .vertical-nav li a {\n            text-decoration: none;\n            color: var(--subtle-text-color);\n            font-size: 0.8rem;\n            letter-spacing: 0.2em;\n            font-weight: 400;\n            text-transform: uppercase;\n            transition: color 0.3s ease;\n        }\n\n        .vertical-nav li a:hover {\n            color: var(--text-color);\n        }\n\n        /* --- Content Sections --- */\n        .content-section {\n            padding: 60px 0;\n            text-align: center;\n        }\n\n        .detail-hero {\n            border-bottom: 1px solid var(--line-color);\n            padding: 80px 0;\n        }\n\n        .detail-hero h1, .detail-hero h2 {\n            font-family: var(--font-heading);\n            font-size: 3rem;\n            letter-spacing: 0.1em;\n            margin: 15px 0;\n            font-weight: 600;\n            color: var(--text-color);\n            text-transform: uppercase;\n        }\n\n        .detail-hero img {\n             width: 500px;\n    height: 517px;\n    object-fit: cover;\n    margin: 10px 0;\n    object-position: top;\n        }\n\n        .full-width-image {\n            position: relative;\n        }\n\n        .full-width-image img {\n           width: 100%;\n    height: 80vh;\n    display: block;\n    object-fit: cover;\n        }\n        \n        .image-overlay-text {\n            position: absolute;\n            bottom: 20px;\n            left: 0;\n            right: 0;\n            padding: 0 50px;\n            display: flex;\n            justify-content: space-between;\n            color: white;\n            font-size: 0.8rem;\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            text-shadow: 1px 1px 3px rgba(0,0,0,0.4);\n        }\n\n        .text-block-section {\n            padding: 100px 50px;\n        }\n\n        .text-block-section h2 {\n            font-family: var(--font-heading);\n            font-size: 2.8rem;\n            font-weight: 600;\n            margin: 0 0 10px 0;\n        }\n\n        .text-block-section .subtitle {\n            font-size: 1rem;\n            letter-spacing: 0.3em;\n            color: var(--subtle-text-color);\n            text-transform: uppercase;\n            margin-bottom: 50px;\n        }\n\n        .two-column-text {\n            display: flex;\n            gap: 40px;\n            text-align: left;\n            max-width: 900px;\n            margin: 0 auto 50px;\n            line-height: 1.8;\n            color: #555;\n        }\n        \n        .column {\n            flex: 1;\n        }\n\n        .cta-button {\n            display: inline-block;\n            text-decoration: none;\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            letter-spacing: 0.2em;\n            color: var(--text-color);\n            border: 1px solid var(--line-color);\n            padding: 12px 30px;\n            text-transform: uppercase;\n            transition: all 0.3s ease;\n        }\n\n        .cta-button:hover {\n            background-color: var(--text-color);\n            color: var(--content-bg-color);\n        }\n        \n        /* --- Responsive Adjustments --- */\n        @media (max-width: 1300px) {\n            .vertical-nav {\n                display: none; /* Hiding vertical nav on smaller screens