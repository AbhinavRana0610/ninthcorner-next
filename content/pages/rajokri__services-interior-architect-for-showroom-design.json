,","theme-color":"#0f141f","canonical":"https://www.ninthcorner.in/rajokri/services-interior-architect-for-showroom-design"},"jsonLd":["{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://www.ninthcorner.in/#organization\",\"name\":\"9th Corner\",\"alternateName\":[\"Ninth Corner\",\"9th-Corner\"],\"url\":\"https://www.ninthcorner.in/\",\"image\":\"https://www.ninthcorner.in/img/logo.avif\",\"logo\":\"https://www.ninthcorner.in/img/logo.avif\",\"description\":\"As expert interior architects specializing in showroom design in Rajokri, we create spaces that are both visually stunning and strategically functional. A showroom is more than just a display area—it’s a brand experience. Our goal is to design interiors that highlight your products\",\"telephone\":\"+91-9310582834\",\"email\":\"ninthcorner83@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Pearls Best Heights I, 808, Netaji Subhash Place, Pitampura\",\"addressLocality\":\"Delhi\",\"postalCode\":\"110034\",\"addressRegion\":\"Delhi\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Rajokri\"},\"sameAs\":[\"https://www.facebook.com/ninthcornerINC\",\"https://www.instagram.com/9thcorner.interiors/\",\"https://www.linkedin.com/company/9th-corner-int/\",\"https://youtube.com/@9thcorner\"]}","{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.ninthcorner.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Rajokri\",\"item\":\"https://www.ninthcorner.in/rajokri/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Interior Architect for Showroom Design in Rajokri\",\"item\":\"https://www.ninthcorner.in/rajokri/services-interior-architect-for-showroom-design\"}]}","{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.ninthcorner.in/#website\",\"name\":\"9th Corner\",\"alternateName\":\"Ninth Corner\",\"url\":\"https://www.ninthcorner.in/\",\"publisher\":{\"@id\":\"https://www.ninthcorner.in/#organization\"}}","{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do you work as an interior architect for showroom design in Rajokri?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We design showrooms along NH48 and in nearby commercial areas, where visibility from the highway is important.\"}},{\"@type\":\"Question\",\"name\":\"How do you design a highway-facing showroom?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Large glazing, bold signage, good night lighting and a clear entry help the showroom catch attention from passing traffic.\"}},{\"@type\":\"Question\",\"name\":\"Can you design large-format showrooms?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Furniture, lighting, automobile and home-décor showrooms need wide circulation and zoned displays, which we plan around your range.\"}},{\"@type\":\"Question\",\"name\":\"Why bring in an interior architect for showroom design before construction?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Early planning sets column-free areas, ceiling heights and service points that a large showroom needs, avoiding costly changes.\"}}]}","{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Interior Architect for Showroom Design in Rajokri, Delhi\",\"serviceType\":\"Interior Architect for Showroom Design\",\"description\":\"Hire an interior architect for showroom design in Rajokri. 9th Corner plans displays, lighting and customer flow that sell products.\",\"url\":\"https://www.ninthcorner.in/rajokri/services-interior-architect-for-showroom-design\",\"provider\":{\"@id\":\"https://www.ninthcorner.in/#organization\"},\"areaServed\":{\"@type\":\"Place\",\"name\":\"Rajokri, Delhi\"}}"],"preloads":[],"html":"<!-- CITY-EXPANSION -->\n    <style>\n        /* New Warm & Elegant Theme Colors */\n        :root {\n            --bg-color: #f4f1ee; /* Warm Off-White */\n            --text-color: #5a5349; /* Warm Gray/Brown Body Text */\n            --heading-color: #4a433a; /* Darker Warm Gray/Brown Headings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        .container {\n            width: 100%;\n            padding: 0 20px;\n            box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400;\n            color: var(--text-color);\n        }\n        b, strong {\n            font-weight: 700;\n            color: var(--heading-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n            background-image: url('/img/gg11.avif'); \n            background-size: cover;\n            background-position: center center;\n            position: relative; \n            overflow: hidden;\n            min-height: 400px;\n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1;\n        }\n        \n        .hero-section::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(30px, 5.5vw, 54px);\n            font-weight: 700;\n            margin-bottom: 0;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .intro-text h2 {\n            font-size: clamp(26px, 3.5vw, 36px);\n            margin-bottom: 20px;\n            color: var(--heading-color);\n            line-height: 1.25;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width,\n        .service-card:nth-child(3),\n        .service-card:nth-child(4) {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n        }\n        .service-card h3 {\n            font-size: 24px;\n            margin-bottom: 15px;\n            color: var(--heading-color);\n        }\n        .service-card p {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 10px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n        .service-card ul {\n            padding-left: 20px;\n            margin: 10px 0;\n        }\n        .service-card li {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 6px;\n            color: var(--text-color);\n        }\n\n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            margin-bottom: 50px;\n        }\n        .why-choose-us h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--accent-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px;\n            font-size: 16px;\n        }\n        .why-choose-intro p {\n            margin-bottom: 10px;\n        }\n        .reason-list {\n            list-style: none;\n            padding: 0;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n        }\n        .reason-list li {\n            background: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border-left: 5px solid var(--accent-color);\n            font-size: 15px;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n            color: var(--heading-color);\n        }\n        .final-cta-message {\n            margin-top: 30px;\n            text-align: center;\n            font-style: italic;\n            font-size: 15px;\n            color: var(--heading-color);\n        }\n        .final-cta-message a {\n            color: var(--accent-color);\n            text-decoration: underline;\n            font-weight: 600;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            margin-bottom: 50px;\n        }\n        .faq-section h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 30px;\n            color: var(--accent-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-bottom: 15px;\n        }\n        .faq-q {\n            font-size: 18px;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 20px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            padding: 14px 38px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(139, 129, 115, 0.3);\n            letter-spacing: 0.5px;\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(74, 67, 58, 0.4);\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Interior Architect for Showroom Design in Rajokri, Delhi</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            <h2>Showrooms on the Delhi-Gurgaon Highway</h2>\n            <p>As an interior architect for showroom design in Rajokri, Delhi, we focus on functional, visually appealing, and brand-focused designs. We ensure your products are showcased optimally, your brand identity is highlighted, and clients have a memorable experience. By merging structural precision with retail psychology, we turn your commercial space into a powerful sales engine.</p>\n            <p>Shops and showrooms along NH-48 near Rajokri, Kapashera and Mahipalpur catch traffic heading to Gurgaon and the airport. Customers often stop on the way, so the store must catch their eye quickly and make it easy to browse and buy. An interior architect for showroom design plans the frontage, the floor and the buying journey as one.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Innovative and Functional Showroom Interiors</h2>\n            <p>\"From high-end retail boutiques to luxury automobile showrooms, we design layouts, lighting, and displays that maximize product visibility and enhance customer engagement. Every showroom is built to leave a lasting impression while supporting your core business objectives.\"</p>\n        </div>\n\n        <!-- SERVICE CATEGORIES GRID (4 CARDS) -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Automobile and Two-Wheeler Showrooms</h3>\n                <p>Vehicle showrooms need clear floor space, strong lighting that shows the paint finish, a delivery bay and a comfortable lounge for families. We plan service reception, a parts counter and a test-drive desk so that sales and service do not get in each other's way.</p><p>Polished, hard-wearing floors handle tyre marks and daily cleaning.</p><p>Customer lounges get charging points, a coffee counter and a clear view of the delivery bay.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Furniture, Marble and Building Material Stores</h3>\n                <p>Heavy, large products need big doors, reinforced floors and display systems that can bear weight. An interior architect for showroom design also plans mock-up rooms, sample walls and good daylight so customers can judge colours and textures properly.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Being Seen From a Fast Road</h3>\n                <p>On a highway, a showroom has only a few seconds to be noticed. A bold facade, well-lit signage, a clear entrance and visible parking make a big difference. Inside, a strong display near the door and a simple route through the store keep visitors moving. Large glass fronts are balanced with shading so the interior does not overheat.</p><p>Night lighting keeps the store visible after dark.</p><p>A recessed mat and an air curtain at the entrance keep highway dust off the floor on windy days.</p><p><b>Brand-Focused Layouts:</b> An interior architect for showroom design creates floor plans that communicate your brand story while directing traffic to key product zones.</p><p><b>Optimized Display:</b> Innovative display systems and customer flow strategies that reduce friction and maximize product engagement time.</p><p><b>Modern Materiality:</b> Strategic use of advanced lighting and premium materials that elevate the perceived value of every item on display.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Our Showroom Planning Steps</h3>\n                <p>First we list your products, stock volumes and how customers arrive, by car, two-wheeler or on foot. Working as your interior architect for showroom design, we then draw zoning options, display units, lighting and the facade, and walk you through the store in 3D before anything is built.</p><p>Site work is planned to keep closures short, and we coordinate with your brand team on graphics and launch timing.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>What Our Interior Architect for Showroom Design Brings</h2>\n            <div class=\"why-choose-intro\">\n                <p>Highway showrooms deal with dust, heat and heavy footfall. We pick materials and fixtures that look good on day one and still hold up after years of use. Cleaning is planned for too, since dust from the road settles quickly.</p>\n            </div>\n            <ul class=\"reason-list\">\n                <li>\n                    <strong>Experienced Architects for Commercial Environments</strong>\n                    Experience with large retail and display spaces.\n                </li>\n                <li>\n                    <strong>Tailored Solutions for Every Brand & Product Category</strong>\n                    Solutions shaped by your brand and product range.\n                </li>\n                <li>\n                    <strong>End-to-End Design & Precise Execution Delivery</strong>\n                    Design and site execution handled together.\n                </li>\n                <li>\n                    <strong>Facades That Catch the Eye</strong>\n                    Signage and lighting planned for passing traffic.\n                </li>\n                <li>\n                    <strong>Tough Materials</strong>\n                    Floors and fixtures built for heavy use.\n                </li>\n            </ul>\n            <div class=\"final-cta-message\">\n                <p>Ready to transform your showroom into a Rajokri landmark? Partner with our architectural experts to design a space that drives results.</p>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects Near Rajokri</h2>\n                <p>Completed interiors by our team in South Extension, Gurgaon and Saket.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                    <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-alok-verma-south-x/mr-alok-verma-south-x/2.avif\" alt=\"Residential project in South Extension, Delhi by 9th Corner\" title=\"South Extension Residence\">\n                            </div>\n                        </div>\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/pro