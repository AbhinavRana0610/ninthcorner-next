dings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0; padding: 0; line-height: 1.6;\n        }\n        .container {\n            width: 100%; padding: 0 20px; box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700; line-height: 1.1; margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400; color: var(--text-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n               background-image: url('/img/e2.avif');  \n            background-size: cover;\n            background-position: center center;\n            position: relative; overflow: hidden;\n            min-height: 400px; \n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            z-index: 1;\n        }\n        .hero-section::before {\n            content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4); z-index: 2;\n        }\n        .hero-section .container {\n            position: relative; z-index: 3;\n        }\n        .hero-section h1 {\n            font-size: clamp(36px, 8vw, 68px); font-weight: 700;\n            margin-bottom: 10px; color: var(--bg-color);\n        }\n        .hero-section p {\n            font-size: clamp(16px, 3vw, 24px); font-weight: 600;\n            color: var(--bg-color); max-width: 800px; margin: 0 auto;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0; max-width: 1400px; margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px; border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle); text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px; margin-bottom: 15px; color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic; font-weight: 600; color: var(--text-color);\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 30px; margin-bottom: 50px;\n        }\n        .service-card {\n            background-color: #ffffff; padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle); border: 1px solid #eee;\n            transition: transform 0.3s, box-shadow 0.3s;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);\n        }\n        .service-card h3 {\n            color: var(--accent-color); font-size: 26px; margin-bottom: 10px;\n        }\n        \n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            padding: 40px 0;\n        }\n        .why-choose-us h2 {\n            text-align: center; font-size: 40px; margin-bottom: 40px;\n            color: var(--heading-color);\n        }\n        .reason-list {\n            display: flex; justify-content: space-around; flex-wrap: wrap;\n            padding: 0; list-style: none; max-width: 900px; margin: 0 auto 40px auto;\n        }\n        .reason-list li {\n            background-color: var(--accent-color); color: var(--bg-color);\n            padding: 15px 25px; margin: 10px; border-radius: 50px;\n            font-weight: 700; box-shadow: var(--shadow-subtle);\n            transition: background-color 0.3s;\n        }\n        .reason-list li:hover { background-color: #6d655a; }\n        .final-cta-message {\n            text-align: center; max-width: 700px; margin: 0 auto;\n            font-size: 1.1em; font-weight: 600; color: var(--heading-color);\n            border-top: 2px solid var(--accent-color); padding-top: 30px;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Modern Interior Design in Rajokri, Delhi</h1>\n            <p>Sleek, Functional, and Timeless Spaces</p>\n        </div>\n    </section>\n\n    <div class=\"container content-wrap\">\n\n        <div class=\"intro-text\">\n            <p>Our modern interior design services in Rajokri, Delhi focus on simplicity, elegance, and functionality. We craft interiors with clean lines, neutral palettes, and contemporary furniture, creating spaces that feel spacious, organized, and visually appealing. Whether you are looking for a minimalist home or a streamlined corporate office, we bring the latest design trends to your doorstep.</p>\n        </div>\n\n        <div class=\"philosophy-box\">\n            <h2>Balancing Style with Practicality</h2>\n            <p>\"We design homes, offices, and commercial spaces that combine aesthetic appeal with everyday functionality. Every element—from furniture to lighting—is curated to create a cohesive, stylish environment tailored to your modern lifestyle.\"</p>\n        </div>\n\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Minimalist Layouts</h3>\n                <p>Achieving maximum impact through decluttered spaces that emphasize architectural beauty and spatial freedom.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Smart Materials</h3>\n                <p>Integrating innovative materials and architectural lighting to add depth and texture to neutral color palettes.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Ergonomic Flow</h3>\n                <p>Modern interior design that isn't just beautiful but is built around the human experience for ultimate comfort.</p>\n            </div>\n        </div>\n\n        <section class=\"why-choose-us\">\n            <h2>Why Choose Us</h2>\n            <ul class=\"reason-list\">\n                <li>Experts in Contemporary Design Principles</li>\n                <li>Customized Solutions for Every Brand & Home</li>\n                <li>End-to-End Professional Project Handling</li>\n            </ul>\n            <p class=\"final-cta-message\">\n                Ready to modernize your world? Partner with the leading interior experts in Rajokri to build a space that defines the future of design.\n            </p>\n        </section>\n\n        <!-- FAQS:auto -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What is modern interior design for a Rajokri home?</h3>\n                    <p class=\"faq-a\">Open layouts, clean lines, large windows, a calm palette and practical furniture, often with a strong connection to the garden.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can a large farmhouse have a modern interior?</h3>\n                    <p class=\"faq-a\">Yes. Modern furniture, simple forms and natural materials suit large farmhouses and keep the spaces airy and relaxed.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Does modern design work for commercial spaces near the highway?</h3>\n                    <p class=\"faq-a\">Yes. Showrooms and offices along NH48 benefit from modern design because it keeps the focus on products and brand.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">How do you keep modern interior design from feeling empty in large rooms?</h3>\n                    <p class=\"faq-a\">Zoned seating, rugs, layered lighting and a few large art pieces make big modern rooms feel warm and lived in.</p>\n                </div>\n            </div>\n        </section>\n        <!-- /FAQS:auto -->\n\n    </div>\n"}