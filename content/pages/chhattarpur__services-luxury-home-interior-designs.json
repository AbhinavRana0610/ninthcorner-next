ww.ninthcorner.in/#organization\"},\"areaServed\":{\"@type\":\"Place\",\"name\":\"Chhattarpur, Delhi\"}}"],"preloads":[],"html":"<!-- CITY-EXPANSION -->\n    <style>\n        /* New Warm & Elegant Theme Colors */\n        :root {\n            --bg-color: #f4f1ee; /* Warm Off-White */\n            --text-color: #5a5349; /* Warm Gray/Brown Body Text */\n            --heading-color: #4a433a; /* Darker Warm Gray/Brown Headings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        .container {\n            width: 100%;\n            padding: 0 20px;\n            box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400;\n            color: var(--text-color);\n        }\n        b, strong {\n            font-weight: 700;\n            color: var(--heading-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n            background-image: url('/img/project/hannu-office/dsc-4540.avif'); \n            background-size: cover;\n            background-position: center center;\n            position: relative; \n            overflow: hidden;\n            min-height: 400px;\n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1;\n        }\n        \n        .hero-section::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(30px, 5.5vw, 54px);\n            font-weight: 700;\n            margin-bottom: 0;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .intro-text h2 {\n            font-size: clamp(26px, 3.5vw, 36px);\n            margin-bottom: 20px;\n            color: var(--heading-color);\n            line-height: 1.25;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width,\n        .service-card:nth-child(3),\n        .service-card:nth-child(4) {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n        }\n        .service-card h3 {\n            font-size: 24px;\n            margin-bottom: 15px;\n            color: var(--heading-color);\n        }\n        .service-card p {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 10px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n        .service-card ul {\n            padding-left: 20px;\n            margin: 10px 0;\n        }\n        .service-card li {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 6px;\n            color: var(--text-color);\n        }\n\n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            margin-bottom: 50px;\n        }\n        .why-choose-us h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--accent-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px;\n            font-size: 16px;\n        }\n        .why-choose-intro p {\n            margin-bottom: 10px;\n        }\n        .reason-list {\n            list-style: none;\n            padding: 0;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n        }\n        .reason-list li {\n            background: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border-left: 5px solid var(--accent-color);\n            font-size: 15px;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n            color: var(--heading-color);\n        }\n        .final-cta-message {\n            margin-top: 30px;\n            text-align: center;\n            font-style: italic;\n            font-size: 15px;\n            color: var(--heading-color);\n        }\n        .final-cta-message a {\n            color: var(--accent-color);\n            text-decoration: underline;\n            font-weight: 600;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            margin-bottom: 50px;\n        }\n        .faq-section h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 30px;\n            color: var(--accent-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-bottom: 15px;\n        }\n        .faq-q {\n            font-size: 18px;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 20px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            padding: 14px 38px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(139, 129, 115, 0.3);\n            letter-spacing: 0.5px;\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(74, 67, 58, 0.4);\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Luxury Home Interior Designs in Chhattarpur, Delhi</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            <h2>Luxury Homes and Estates Around Chhattarpur</h2>\n            <p>We craft luxury home interior designs in Chhattarpur, Delhi that combine opulence, personalization, and functionality. Every residence is designed with premium finishes, bespoke furniture, and thoughtful layouts to create spaces that are elegant, comfortable, and truly yours. From grand entryways to serene private retreats, we bring a sense of high-end living to every square inch of your home.</p>\n            <p>Some of Delhi's largest private homes sit on the farm estates around Chhattarpur, Satbari and Sultanpur. With so much space, the challenge is to make rooms feel grand without feeling empty. Our luxury home interior designs for these properties balance scale with warmth, so the house works for a family dinner as well as for a gathering of a hundred guests.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>High-End Residential Solutions</h2>\n            <p>\"From grand living areas and master suites to outdoor patios and home offices, our designs reflect your taste and elevate lifestyle standards. We make each home a unique statement of luxury and sophistication, utilizing contemporary trends alongside timeless design principles.\"</p>\n        </div>\n\n        <!-- SERVICE CATEGORIES GRID (4 CARDS) -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Grand Living and Dining Halls</h3>\n                <p>Double-height living rooms and long dining halls need careful planning. We break large rooms into zones with rugs, furniture groups and ceiling features, and use layered lighting so the space feels intimate in the evening.</p><p>Formal dining rooms often get a large chandelier, a crockery display and a bar counter that serves both the dining area and the lawn.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Bedroom Suites and Wellness Rooms</h3>\n                <p>Private suites in luxury home interior designs often include a dressing room, a sitting area and a large bathroom with a steam shower or tub. Many estate homes also add a gym, a spa room or an indoor pool area, each with proper ventilation and slip-resistant floors.</p><p>Guest wings with their own entrance are popular on estates, so visiting family can stay in comfort without disturbing the main house.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Choosing Materials That Last</h3>\n                <p>Italian marble, onyx, solid teak and quality veneers look rich, but they also need the right care. We help you choose finishes that suit how the room is used: polished stone for formal areas, honed or textured stone near pools, sealed wood in high-traffic spaces. Fabric choices take sunlight and dust into account.</p><p>Home automation for lights, curtains, cameras and climate is planned during the design stage, not added later.</p><p><b>Premium Materials:</b> Sourcing global materials and crafting custom furnishings to ensure a unique, ultra-luxurious finish for your home.</p><p><b>Functional Elegance:</b> Luxury home interior designs with layouts that flow naturally, ensuring that even the most opulent spaces remain highly practical for daily life.</p><p><b>Personalized Interiors:</b> Creating tailored interior concepts that harmonize your personal story with the architectural integrity of the residence.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>How a Luxury Project Moves Forward</h3>\n                <p>We spend time understanding your lifestyle, your collections and the feel you want. We then turn those notes into luxury home interior designs you can review room by room, with stone and wood samples laid out side by side and 3D images of each space.</p><p>During execution, skilled craftsmen and trusted vendors work under close supervision, and no room is signed off until the joinery, stone and lighting pass our checks.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>What Sets Our Luxury Home Interior Designs Apart</h2>\n            <div class=\"why-choose-intro\">\n                <p>Large homes need strong project management. We coordinate many trades at once and keep the site organised, secure and on schedule.</p>\n            </div>\n            <ul class=\"reason-list\">\n                <li>\n                    <strong>Skilled in High-End Residential Design</strong>\n                    Work on large villas, estates and premium homes.\n                </li>\n                <li>\n                    <strong>Tailored Solutions for Your Preferences</strong>\n                    Spaces shaped around how your family lives and entertains.\n                </li>\n                <li>\n                    <strong>Comprehensive Design & Execution Services</strong>\n                    Complete delivery with close site supervision.\n                </li>\n                <li>\n                    <strong>Automation Planned Early</strong>\n                    Lights, curtains and cameras built in, not bolted on.\n                </li>\n                <li>\n                    <strong>Materials With Care Guides</strong>\n                    Advice on keeping stone and wood looking new.\n                </li>\n            </ul>\n            <div class=\"final-cta-message\">\n                <p>Experience the pinnacle of residential design. Partner with Chhattarpur's premier luxury interior specialists to create a home that transcends the ordinary.</p>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects Near Chhattarpur</h2>\n                <p>Premium residences finished by our team in Gurgaon, Saket and Green Park.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                    <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-sachin-saket/mr-sachin-saket/2.avif\" alt=\"Home interior project in Saket, Delhi by 9th Corner\" title=\"Saket Home Interior\">\n                            </div>\n                        </div>\n                        <div c