/\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 30px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-family: var(--font-sans);\n            font-size: 16px;\n            font-weight: 600;\n            padding: 12px 36px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: var(--shadow-subtle);\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);\n        }\n\n        /* Work Gallery Carousel */\n        .work-gallery-section {\n            margin-top: 40px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        .gallery-card-content {\n            padding: 22px 20px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n        .gallery-card-content h3 {\n            font-size: 20px;\n            margin-bottom: 8px;\n            color: var(--heading-color);\n            line-height: 1.3;\n        }\n        .gallery-card-content p {\n            font-size: 14px;\n            line-height: 1.6;\n            margin: 0;\n            color: var(--text-color);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n                /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Farmhouse Interior Designer in Noida</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            \n            <h2>Farmhouse Interior Design for Peaceful and Comfortable Living</h2>\n            <p>A farmhouse must represent tranquility, open space, and a relationship with the environment. Interior space contributes to achieving a connection with nature, a cozy home, and contemporary design. As a <b>Farmhouse Interior Designer in Noida</b>, we plan interiors that suit the property, lifestyle, and personal taste of the people using it. Our goal is to make every room feel calm, practical and easy for family life.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Farmhouse Interior Design for a Modern and Natural Look</h2>\n            <p>The insides of a farmhouse shouldn&#39;t fit into just one particular mode. A farmhouse interior designer can blend rustic elements with contemporary furniture, like pieces that are streamlined and have a neutral palette with warm tones. Natural materials and earthy tones, wooden pieces, and plush textures bring comfort.</p>\n            <p>Our perspective on the approach to <b>farmhouse interior design in Noida</b> is to balance contemporary convenience and vintage flavor. Appropriate furniture and neutral tones, accompanied by simplistic accents, natural finishes, and spacious rooms, are also key. The design approach is the core of the farmhouse and not just ornamentation.</p>\n        </div>\n\n        <!-- SERVICES GRID -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Open Layouts That Bring More Light</h3>\n                <p>A farmhouse usually offers more space than a city home, so it pays to use it well. A farmhouse interior designer can achieve this in several ways: spacious living and dining areas, comfortable bedrooms and inviting outdoor spaces.</p><p>Large windows can also give more light into a house, and can connect you more to the outside world. Clear movement between rooms can also make daily use easier. Our <b>farmhouse design services</b>&nbsp;focus on open and airy layouts where space, light, furniture, and movement work together.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Bringing The Outdoors Inside</h3>\n                <p>Bringing nature into a farmhouse can be integral to the feel of the space. Instead of dividing indoor and outdoor space up completely, a farmhouse interior designer may design a continuous visual link between the spaces. Large openings, natural materials, neutral colours and outdoor seating might assist this within the interiors.</p><p>A <b>well-planned farmhouse interior design service in Noida</b>&nbsp;considers the garden, open areas, views, and surrounding environment while planning the inside space. This creates a setting for relaxing, family time, and quiet moments away from busy city life.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Spaces Planned Around Your Needs</h3>\n                <p>For a farmhouse interior designer in Noida, every farmhouse has different requirements. Some may need family areas, while others may focus on guest rooms, private corners, entertainment areas, or outdoor sitting spaces. The interior should reflect these needs instead of using the same design everywhere.</p><p>We do <b>farmhouse interiors</b>&nbsp;that suit you and your lifestyle, taste, space as well as your comfort. We plan furniture, lighting as well as textures and finishes to enhance its functional living environment and make the interior a real farmhouse but simple and interconnected.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Complete Planning For A Smooth Project</h3>\n                <p>Good design needs proper planning from the beginning. As a farmhouse interior designer, we understand the property, discuss the client&rsquo;s expectations, and develop the interior around the available space. This includes layout planning, design details, material choices, furniture, lighting, and other important elements.</p><p>Our Noida-based company that <b>designs farmhouse interior decor</b>&nbsp;also takes care of the execution of the project from end to end. With clear planning, every task comes together smoothly and the project stays simple for you.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>Why Choose A Farmhouse Specialist?</h2>\n            <p style=\"text-align:center; max-width:900px; margin: 0 auto 15px;\">A farmhouse interior designer gives every project specific consideration as it involves <b>blending interior comfort</b>&nbsp;with the natural environment. Prior knowledge of country-style spaces aids better decisions on layout, materials, light, furnishing and natural elements.</p>\n            <p style=\"text-align:center; max-width:900px; margin: 0 auto 15px;\">An <b>interior designer capable in farmhouse</b>&nbsp;interiors can blend traditional with modern furnishings to result in interiors that are cozy, modern, peaceful and comfortable. In addition to this, a customized blueprint of the home could also be in effect, as every area can be custom designed according to the inhabitants&#39; preferences.</p>\n        </section>\n\n        <!-- FAQS -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What makes a farmhouse interior different from a regular home?</h3>\n                    <p class=\"faq-a\">A farmhouse interior usually gives more attention to open layouts, natural materials, earthy colours, outdoor connections, and a relaxed feeling.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can a farmhouse have a modern interior?</h3>\n                    <p class=\"faq-a\">Sure. A farmhouse interior designer in Noida can combine rustic elements with modern furniture, modern lighting, modern finishes, and open layout design.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Is there a wider range of interior design services to choose from?</h3>\n                    <p class=\"faq-a\">Yes, a wide range of interior design services is available to meet different project needs. You can explore the available choices and select the services that best match your space.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can the farmhouse interior be customized?</h3>\n                    <p class=\"faq-a\">Yes. Everything from the floor plan, furniture, colors, materials, lighting, and other factors can be organized based on personal tastes and requirements.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Do you manage the complete interior project?</h3>\n                    <p class=\"faq-a\">Yes. Our farmhouse interior designer service can cover planning and project management from design through execution.</p>\n                </div>\n            </div>\n            <div class=\"learn-more-wrap\">\n                <a href=\"https://www.ninthcorner.in/noida/services\" class=\"learn-more-btn\">Learn More</a>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects in Noida</h2>\n                <p>Showcasing our completed residential and commercial spaces designed with excellence.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                                        <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-anand-kumar-noida/mr-anand-kumar-noida/519.avif\" alt=\"Luxury residential interior project in Noida by N