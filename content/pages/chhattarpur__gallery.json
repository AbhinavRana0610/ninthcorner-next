{"route":"/chhattarpur/gallery","city":"chhattarpur","nested":false,"meta":{"og":{"type":"website","site_name":"9th-Corner","title":"Interior Design Gallery | Chhattarpur | 9th Corner","description":"Browse interior design ideas from 9th Corner for homes and offices in Chhattarpur: living rooms, kitchens, bedrooms, facades and full projects.","url":"https://www.ninthcorner.in/chhattarpur/gallery","image":"https://www.ninthcorner.in/img/og-default.jpg","image:width":"1200","image:height":"630"},"twitter":{"card":"summary_large_image","title":"Interior Design Gallery | Chhattarpur | 9th Corner","description":"Browse interior design ideas from 9th Corner for homes and offices in Chhattarpur: living rooms, kitchens, bedrooms, facades and full projects.","image":"https://www.ninthcorner.in/img/og-default.jpg"},"title":"Interior Design Gallery | Chhattarpur | 9th Corner","robots":"index, follow","author":"9th-Corner","publisher":"9th-Corner","google-site-verification":"bFDxjFr1uDW3hEQ7YEzagKY9ZLzkrW1k1vtMcyQahyE","description":"Browse interior design ideas from 9th Corner for homes and offices in Chhattarpur: living rooms, kitchens, bedrooms, facades and full projects.","keywords":"Architecture services in  Chhattarpur, Best architects in  Chhattarpur, Residential architecture  Chhattarpur, Commercial architects  Chhattarpur, Architecture firm in  Chhattarpur","theme-color":"#0f141f","canonical":"https://www.ninthcorner.in/chhattarpur/gallery"},"jsonLd":["{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://www.ninthcorner.in/#organization\",\"name\":\"9th Corner\",\"alternateName\":[\"Ninth Corner\",\"9th-Corner\"],\"url\":\"https://www.ninthcorner.in/\",\"image\":\"https://www.ninthcorner.in/img/logo.avif\",\"logo\":\"https://www.ninthcorner.in/img/logo.avif\",\"description\":\"Browse the 9th-Corner gallery for interior design inspiration in Chhattarpur - luxury living rooms, bedrooms, offices and custom furniture.\",\"telephone\":\"+91-9310582834\",\"email\":\"ninthcorner83@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Pearls Best Heights I, 808, Netaji Subhash Place, Pitampura\",\"addressLocality\":\"Delhi\",\"postalCode\":\"110034\",\"addressRegion\":\"Delhi\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Chhattarpur\"},\"sameAs\":[\"https://www.facebook.com/ninthcornerINC\",\"https://www.instagram.com/9thcorner.interiors/\",\"https://www.linkedin.com/company/9th-corner-int/\",\"https://youtube.com/@9thcorner\"]}","{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.ninthcorner.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Chhattarpur\",\"item\":\"https://www.ninthcorner.in/chhattarpur/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Interior Design Gallery in Chhattarpur\",\"item\":\"https://www.ninthcorner.in/chhattarpur/gallery\"}]}","{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.ninthcorner.in/#website\",\"name\":\"9th Corner\",\"alternateName\":\"Ninth Corner\",\"url\":\"https://www.ninthcorner.in/\",\"publisher\":{\"@id\":\"https://www.ninthcorner.in/#organization\"}}"],"preloads":[],"html":"\n\n      <style>\n        /* General Styles */\n        :root {\n            --dark-color: #1a1a1a; /* Slightly deeper black */\n            --light-text: #ffffff;\n            --secondary-bg: #f8f8f8; /* Soft background */\n            --accent-color: #f7a000; /* Warm accent orange */\n            --subtle-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);\n            --transition-speed: 0.3s;\n        }\n\n        body {\n            font-family: 'Poppins', 'Inter', sans-serif;\n            margin: 0;\n            padding: 0;\n            background-color: var(--secondary-bg);\n            color: var(--dark-color);\n            line-height: 1.6;\n        }\n\n         .banner-section1, .projects-grid-section {\n            position: relative;\n            width: 100%;\n            scroll-behavior: smooth; \n        }\n\n        /* --- Banner Section (Parallax) --- */\n        .banner-section1 {\n            height: 70vh;\n            /* Placeholder image (must be a URL since local files are not supported) */\n            background-image: url('/img/ga.avif');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed; /* CRITICAL for Parallax on desktop */\n            \n            box-shadow: inset 0 -10px 10px rgba(0, 0, 0, 0.2); \n\n            display: flex; \n            justify-content: center;\n            align-items: flex-end;\n            padding-bottom: 30px;\n        }\n\n        /* Fallback for better mobile compatibility/performance */\n        @media (max-width: 640px) {\n            .banner-section1 {\n                      background-attachment: scroll;\n      height: 35dvh;\n        background-size: cover;\n            }\n        }\n\n        /* Dark overlay for readability */\n        .banner-section1::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            bottom: 0;\n            left: 0;\n            /* background-color: rgba(0, 0, 0, 0.4); */\n        }\n        \n        /* --- Scroll Down Indicator Styling --- */\n        .scroll-indicator {\n            color: white;\n            font-size: 1rem;\n            font-weight: 600;\n            text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            opacity: 0.8;\n            cursor: pointer;\n            transition: opacity 0.3s;\n            z-index: 10; \n        }\n\n        .scroll-indicator:hover {\n            opacity: 1;\n        }\n\n        .scroll-indicator svg {\n            width: 30px;\n            height: 30px;\n            fill: white;\n            animation: bounce 1.5s infinite;\n        }\n\n        /* Bouncing animation for the indicator */\n        @keyframes bounce {\n            0%, 20%, 50%, 80%, 100% {\n                transform: translateY(0);\n            }\n            40% {\n                transform: translateY(-10px);\n            }\n            60% {\n                transform: translateY(-5px);\n            }\n        }\n\n        /* Portfolio Section */\n        #portfolio-section {\n            padding: 60px 20px;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .heading-container {\n            text-align: center;\n            margin-bottom: 50px;\n        }\n\n        .heading-container h1 {\n            font-size: 3rem;\n            margin-bottom: 5px;\n            font-weight: 700;\n            color: var(--dark-color);\n            letter-spacing: -0.5px;\n        }\n\n        .heading-container p {\n            font-size: 1.25rem;\n            color: #777;\n            font-style: normal;\n            font-weight: 300;\n        }\n\n        /* Filter Buttons */\n        .filter-buttons {\n            display: flex;\n            justify-content: center;\n            flex-wrap: wrap;\n            gap: 15px;\n            margin-bottom: 50px;\n        }\n\n        .filter-buttons button {\n           background-color: transparent;\n    color: #212121;\n    border: 1px solid #212121;\n    padding: 12px 25px;\n    border-radius: 50px;\n    cursor: pointer;\n    transition: all var(--transition-speed) \nease;\n    font-weight: 600;\n    font-size: 1rem;\n    box-shadow: 0 4px 6px rgb(49 48 48 / 12%);\n        }\n\n        .filter-buttons button:hover:not(.active) {\n            background-color: #212121;\n            color:#fff;\n            transform: translateY(-1px);\n        }\n\n        .filter-buttons button.active {\n          background-color: #212121;\n    color: #fff;\n    transform: translateY(-2px);\n        }\n\n        /* Gallery Grid */\n        .gallery-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 30px;\n        }\n\n        .gallery-item {\n            overflow: hidden;\n            border-radius: 16px; /* Larger radius for a softer look */\n            box-shadow: var(--subtle-shadow);\n            cursor: pointer;\n            position: relative;\n            transition: all 0.5s ease;\n            transform: scale(1);\n            opacity: 1;\n            background-color: var(--light-text);\n        }\n        \n        .gallery-item:hover {\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); /* Lift on hover */\n            transform: translateY(-5px);\n        }\n        \n        /* Hide element for filtering */\n        .gallery-item.hidden {\n            display: none !important;\n            opacity: 0;\n            transform: scale(0.9);\n        }\n\n        .gallery-item img {\n            width: 100%;\n            height: 320px; /* Slightly taller images */\n            object-fit: cover;\n            display: block;\n            transition: transform 0.4s ease;\n        }\n\n        .gallery-item:hover img {\n            transform: scale(1.03); /* Smaller scale increase on hover */\n        }\n\n        /* Lightbox Modal */\n        #lightbox-modal {\n            display: none; \n            position: fixed;\n            z-index: 10000; /* High z-index */\n            left: 0;\n            top: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(0, 0, 0, 0.95); /* Darker backdrop */\n            backdrop-filter: blur(8px); /* Stronger blur */\n            align-items: center;\n            justify-content: center;\n            transition: opacity 0.3s;\n        }\n\n        .lightbox-content {\n            position: relative;\n            max-width: 95%;\n            max-height: 95%;\n            margin: auto;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #lightbox-image {\n            display: block;\n            max-width: 100%;\n            max-height: 90vh; \n            border-radius: 16px;\n            box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);\n            transition: transform 0.2s;\n        }\n\n        /* Close Button */\n        .close-btn {\n            position: fixed; /* Fixed position relative to viewport */\n            top: 30px;\n            right: 40px;\n            color: var(--light-text);\n            font-size: 50px;\n            font-weight: 300;\n            transition: var(--transition-speed);\n            cursor: pointer;\n            z-index: 10001;\n            opacity: 0.8;\n        }\n\n        .close-btn:hover {\n            color: var(--accent-color);\n            transform: rotate(90deg);\n            opacity: 1;\n        }\n\n        /* Navigation Arrows */\n        .prev, .next {\n            cursor: pointer;\n            position: absolute;\n            top: 50%;\n            width: auto;\n            padding: 20px;\n            margin-top: -30px; /* Center arrow icon better */\n            color: var(--light-text);\n            font-weight: 300;\n            font-size: 40px;\n            transition: background-color var(--transition-speed), color var(--transition-speed);\n            user-select: none;\n            background-color: rgba(0, 0, 0, 0.4);\n            /* border-radius: 50%; */\n            line-height: 1; \n            z-index: 10001;\n        }\n\n        .prev {\n            left: 30px;\n        }\n\n        .next {\n            right: 30px;\n        }\n\n        .prev:hover, .next:hover {\n            background-color: var(--accent-color);\n            color: var(--dark-color);\n        }\n\n        @media screen and (min-width:320px) and (max-width:500px){\n            .heading-container h1 {\n    font-size: 28px;\n    margin-bottom: 5px;\n    font-weight: 700;\n    color: var(--dark-color);\n    letter-spacing: -0.5px;\n}\n\n.gallery-grid {\n    display: grid;\n    grid-template-columns: unset;\n    gap: 30px;\n}\n            \n        }\n    </style>\n\n\n\n    <!-- Parallax Banner -->\n    <section class=\"banner-section1\">\n        <div class=\"scroll-indicator\" onclick=\"document.querySelector('.projects-grid-section').scrollIntoView({ behavior: 'smooth' });\">\n            <div class=\"scroll-h\">\n                <!-- <h1>Creating spaces that tell your story.</h1> -->\n    </div>\n            <!-- <p>Scroll Down</p> -->\n            <svg viewBox=\"0 0 24 24\">\n                <path d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\"/>\n            </svg>\n        </div>\n    </section>\n\n    <!-- Portfolio Section -->\n    <section id=\"portfolio-section\">\n        <div class=\"heading-container\">\n            <h1>Our Interior Design Portfolio</h1>\n            <p>A Glimpse Into Our Crafted Spaces</p>\n        </div>\n\n        <!-- Filter Buttons -->\n        <div class=\"filter-buttons\">\n            <button class=\"filter-btn active\" data-filter=\"all\">All</button>\n            <button class=\"filter-btn\" data-filter=\"living\">Living Spaces</button>\n            <button class=\"filter-btn\" data-filter=\"kitchen\">Kitchens</button>\n            <button class=\"filter-btn\" data-filter=\"projects\">Projects</button>\n        </div>\n\n        <!-- Gallery Grid -->\n        <div class=\"gallery-grid\">\n            <!-- Gallery Items (Using placeholder images) -->\n            <div class=\"gallery-item\" data-category=\"living\" data-index=\"0\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" src=\"/img/ch18.avif\" alt=\"Cozy Living Space\" title=\"Cozy Living Space\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"kitchen\" data-index=\"1\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-sachin-saket/mr-sachin-saket/36.avif\" alt=\"Modern Kitchen Design\" title=\"Modern Kitchen Design\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"projects\" data-index=\"2\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-umesh-jain-bhivani/mr-umesh-jain-bhivani/2.avif\" alt=\"Contemporary facade with curved balconies at Mr Umesh Jain residence in Bhiwani by Ninth Corner\" title=\"Contemporary facade with curved balconies at Mr Umesh Jain residence in Bhiwani by Ninth Corner\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"living\" data-index=\"3\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/ch12.avif\" alt=\"Double-height foyer with floating marble staircase and sculpture by Ninth Corner\" title=\"Double-height foyer with floating marble staircase and sculpture by Ninth Corner\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"kitchen\" data-index=\"4\">\n                <img width=\"2560\" height=\"1946\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/dr-ak-jain-model-town/dr-ak-jain-model-town/70.avif\" alt=\"Minimalist Kitchen\" title=\"Minimalist Kitchen\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"projects\" data-index=\"5\">\n                <img width=\"2560\" height=\"2560\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-anand-kumar-noida/mr-anand-kumar-noida/2.avif\" alt=\"Retail Design Project\" title=\"Retail Design Project\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"living\" data-index=\"6\">\n                <img width=\"2560\" height=\"1440\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-arun-ashok-vihar/mr-arun-ashok-vihar/3.avif\" alt=\"Contemporary Living\" title=\"Contemporary Living\">\n            </div>\n            <!-- <div class=\"gallery-item\" data-category=\"kitchen\" data-index=\"7\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-virend-singh-gurgaon/mr-virend-singh-gurgaon/2.avif\" alt=\"Open Plan Kitchen\" title=\"Open Plan Kitchen\">\n            </div> -->\n             <div class=\"gallery-item\" data-category=\"living\" data-index=\"8\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/ch20.avif\" alt=\"Cozy Living Space\" title=\"Cozy Living Space\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"kitchen\" data-index=\"9\">\n                <img width=\"2500\" height=\"2000\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-alok-verma-south-x/mr-alok-verma-south-x/218.avif\" alt=\"Modern Kitchen Design\" title=\"Modern Kitchen Design\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"projects\" data-index=\"10\">\n                <img width=\"789\" height=\"947\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-rao-green-park/mr-rao-green-park/2.avif\" alt=\"Modern facade with landscaped terraces at Mr Rao residence in Green Park by Ninth Corner\" title=\"Modern facade with landscaped terraces at Mr Rao residence in Green Park by Ninth Corner\">\n            </div>\n            <div class=\"gallery-item\" data-category=\"living\" data-index=\"11\">\n                <img width=\"2560\" height=\"1440\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-rana-noida/mr-rana-noida/8.avif\" alt=\"Dining room with twelve-seater table and ring chandelier at Mr Rana residence in Noida by Ninth Corner\" title=\"Dining room with twelve-seater table and ring chandelier at Mr Rana residence in Noida by Ninth Corner\">\n            </div>\n            <!-- <div class=\"gallery-item\" data-category=\"kitchen\" data-index=\"12\">\n                <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-alok-verma-south-x/mr-alok-verma-south-x/2.avif\" alt=\"Minimalist Kitchen\" title=\"Minimalist Kitchen\">\n            </div> -->\n        </div>\n    </section>\n\n    <!-- Lightbox Modal -->\n    <div id=\"lightbox-modal\">\n        <span class=\"close-btn\">&times;</span>\n        <div class=\"lightbox-content\">\n            <a title=\"Previous slide\" class=\"prev\" aria-label=\"Previous Image\">&#10094;</a>\n            <img decoding=\"async\" loading=\"lazy\" id=\"lightbox-image\" src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E\" alt=\"Ninth Corner interior design portfolio photo, enlarged view\" title=\"Ninth Corner interior design portfolio photo, enlarged view\">\n            <a title=\"Next slide\" class=\"next\" aria-label=\"Next Image\">&#10095;</a>\n        </div>\n    </div>\n\n   <script>\n    // --- Gallery Filtering Logic ---\n    const filterButtons = document.querySelectorAll('.filter-btn');\n    const galleryItems = document.querySelectorAll('.gallery-item');\n\n    filterButtons.forEach(button => {\n        button.addEventListener('click', () => {\n            // Remove 'active' from all buttons\n            filterButtons.forEach(btn => btn.classList.remove('active'));\n\n            // Add 'active' to the clicked button\n            button.classList.add('active');\n\n            const filter = button.dataset.filter;\n\n            galleryItems.forEach(item => {\n                const category = item.dataset.category;\n\n                if (filter === 'all' || category === filter) {\n                    // Show item\n                    item.style.display = 'block'; // Ensure block display for grid flow\n                    // Set timeout to allow display change before removing hidden class for smoother transition\n                    setTimeout(() => {\n                        item.classList.remove('hidden');\n                    }, 50);\n\n                } else {\n                    // Hide item\n                    item.classList.add('hidden');\n                    // Use a short delay before setting display: none to allow the opacity/scale transition to run\n                    setTimeout(() => {\n                        item.style.display = 'none';\n                    }, 400);\n                }\n            });\n        });\n    });\n\n    // --- Lightbox Modal Logic ---\n    const modal = document.getElementById('lightbox-modal');\n    const modalImage = document.getElementById('lightbox-image');\n    const closeBtn = document.querySelector('.close-btn');\n    const prevBtn = document.querySelector('.prev');\n    const nextBtn = document.querySelector('.next');\n\n    let currentGalleryArray = []; // Array of currently filtered images\n    let currentIndex = 0;\n\n    // Function to update the image in the modal\n    function updateModalImage() {\n        if (currentGalleryArray.length > 0) {\n            const item = currentGalleryArray[currentIndex];\n            modalImage.src = item.querySelector('img').src;\n            modalImage.alt = item.querySelector('img').alt;\n        }\n    }\n\n    // Open Modal\n    galleryItems.forEach(item => {\n        item.addEventListener('click', function() {\n            // 1. Determine the currently visible images (for navigation)\n            // Filter out items that are explicitly hidden by the filter logic\n            currentGalleryArray = Array.from(document.querySelectorAll('.gallery-item')).filter(\n                el => !el.classList.contains('hidden')\n            );\n\n            // 2. Find the index of the clicked image in the filtered array\n            const clickedElement = this;\n            currentIndex = currentGalleryArray.findIndex(el => el === clickedElement);\n\n            // 3. Open the modal\n            modal.style.display = 'flex';\n            updateModalImage();\n        });\n    });\n\n    // Close Modal Handlers\n    closeBtn.onclick = function() {\n        modal.style.display = 'none';\n    }\n    modal.onclick = function(event) {\n        // Close modal if user clicks outside the image/arrows (on the modal backdrop itself)\n        if (event.target === modal) {\n            modal.style.display = 'none';\n        }\n    }\n\n    // Navigation Functions\n    prevBtn.onclick = function(event) {\n        event.stopPropagation(); // FIXED: Stop click from bubbling to the modal background\n        if (currentGalleryArray.length === 0) return;\n        currentIndex = (currentIndex - 1 + currentGalleryArray.length) % currentGalleryArray.length;\n        updateModalImage();\n    }\n\n    nextBtn.onclick = function(event) {\n        event.stopPropagation(); // FIXED: Stop click from bubbling to the modal background\n        if (currentGalleryArray.length === 0) return;\n        currentIndex = (currentIndex + 1) % currentGalleryArray.length;\n        updateModalImage();\n    }\n\n    // Keyboard Navigation\n    document.onkeydown = function(e) {\n        if (modal.style.display === 'flex') {\n            e = e || window.event;\n            if (e.key === 'ArrowLeft') {\n                prevBtn.click();\n            } else if (e.key === 'ArrowRight') {\n                nextBtn.click();\n            } else if (e.key === 'Escape') {\n                closeBtn.click();\n            }\n        }\n    };\n</script>\n"}