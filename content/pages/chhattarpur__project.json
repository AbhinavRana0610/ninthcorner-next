ound-image: url('/img/projects.avif');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed; /* CRITICAL for Parallax on desktop */\n            \n            box-shadow: inset 0 -10px 10px rgba(0, 0, 0, 0.2); \n\n            display: flex; \n            justify-content: center;\n            align-items: flex-end;\n            padding-bottom: 30px;\n        }\n\n        /* Fallback for better mobile compatibility/performance */\n        @media (max-width: 640px) {\n            .banner-section1 {\n                       background-attachment: scroll;\n       height: 35dvh;\n        background-size: cover;\n            }\n        }\n\n        /* Dark overlay for readability */\n        .banner-section1::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            bottom: 0;\n            left: 0;\n            /* background-color: rgba(0, 0, 0, 0.4); */\n        }\n        \n        /* --- Scroll Down Indicator Styling --- */\n        .scroll-indicator {\n            color: white;\n            font-size: 1rem;\n            font-weight: 600;\n            text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            opacity: 0.8;\n            cursor: pointer;\n            transition: opacity 0.3s;\n            z-index: 10; \n        }\n\n        .scroll-indicator:hover {\n            opacity: 1;\n        }\n\n        .scroll-indicator svg {\n            width: 30px;\n            height: 30px;\n            fill: white;\n            animation: bounce 1.5s infinite;\n        }\n\n        /* Bouncing animation for the indicator */\n        @keyframes bounce {\n            0%, 20%, 50%, 80%, 100% {\n                transform: translateY(0);\n            }\n            40% {\n                transform: translateY(-10px);\n            }\n            60% {\n                transform: translateY(-5px);\n            }\n        }\n\n        .projects-grid-section {\n            padding: 4rem 0;\n            background-color: #ffffff;\n            /* Removed text-align: center */\n            border-radius: 1rem 1rem 0 0;\n            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.1);\n        }\n\n        /* Container for Centering Content Block (Max Width) */\n        .container {\n            max-width: 1280px;\n            margin-left: auto;\n            margin-right: auto;\n            padding-left: 1.5rem;\n            padding-right: 1.5rem;\n        }\n\n        /* Typography */\n        .project-heading {\n           font-weight: 900;\n    color: #343434;\n    text-align: center;\n    font-size: 2.25rem;\n    margin-bottom: 3rem;\n        }\n\n         .project-heading2 {\n              font-weight: 200;\n    color: #626262;\n    text-align: center;\n    font-size: 1.2rem;\n    line-height: 1.6rem;\n   padding: 0 150px;\n        }\n        \n        /* Image Grid Layout (Uniform Grid) */\n        .image-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem; \n        }\n\n        /* --- Project Item Styling (Removed Card Look) --- */\n        /* Main Project Item Container (Now just a layout wrapper) */\n        .project-card {\n            display: flex; \n            flex-direction: column;\n            position: relative;\n            /* Added height 100% to ensure all cards stretch vertically in the grid cell */\n            height: 100%;\n            overflow: hidden; \n            transition: none; /* No transition needed */\n        }\n        \n        /* Image Container */\n        .img-container {\n            display: block; \n            position: relative;\n            overflow: hidden;\n            aspect-ratio: 4 / 4;\n            flex-shrink: 0;\n            border-radius: 0.5rem; /* Softened corners on the image itself */\n            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Subtle shadow just on image */\n        }\n\n        .img-container img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            transition: none; \n        }\n        \n        /* Project Info Section (Name and Button) */\n        .project-info {\n            padding: 1rem 0 1rem;\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start; /* Aligned Left */\n            flex-grow: 1; /* Allows this section to fill all available space */\n        }\n\n        .project-title-name {\n         font-size: 1.55rem;\n    font-weight: 300;\n    color: #212121;\n    margin-bottom: 0.25rem;\n    text-align: left;\n        }\n\n        /* View More Button Link */\n        .view-more-button-link {\n            /* --- CRITICAL CHANGE FOR ALIGNMENT --- */\n           margin-top: auto;\n    display: inline-block;\n    padding: 0.6rem 2rem;\n    background-color: transparent;\n    color: #212121;\n    font-weight: 500;\n    border-radius: 0.5rem;\n    transition: background-color 0.5s \nease, transform 0.3s;\n    font-size: 0.95rem;\n    border: 1px solid #212121;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    text-decoration: none;\n    /* box-shadow: 0 4px 10px rgba(33, 33, 33, 0.3); */\n    cursor: pointer;\n        }\n\n        .view-more-button-link:hover {\n            background-color: #000000; /* UPDATED: Pure black on hover */\n            transform: translateY(-1px);\n            color: #fff;\n            box-shadow: 0 6px 12px rgba(33, 33, 33, 0.4); /* UPDATED: Darker hover shadow */\n        }\n\n        /* Responsive Design: Force 3 columns on larger screens */\n        @media (min-width: 768px) {\n            .project-heading {\n                font-size: 3.5rem;\n            }\n            .projects-grid-section {\n                padding: 6rem 0;\n            }\n            .container {\n                padding-left: 2rem;\n                padding-right: 2rem;\n            }\n            .image-grid {\n                grid-template-columns: repeat(3, 1fr);\n            }\n        }\n\n        @media screen and (min-width: 320px) and (max-width: 500px) {\n            .project-heading2 {\n    font-weight: 200;\n    color: #626262;\n    text-align: center;\n    font-size: 1.2rem;\n    line-height: 1.6rem;\n    padding: 0 0px !important;\n}\n        }\n\n        \n    </style>\n\n\n\n     <section class=\"banner-section1\">\n        <!-- Scroll Down Indicator -->\n        <div class=\"scroll-indicator\" onclick=\"document.querySelector('.projects-grid-section').scrollIntoView({ behavior: 'smooth' });\">\n            <!-- SVG Arrow Icon -->\n            <svg viewBox=\"0 0 24 24\">\n                <path d=\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\"/>\n            </svg>\n        </div>\n    </section>\n\n    <section class=\"projects-grid-section\">\n        <h1 class=\"project-heading\">Our Latest Interior Design Projects</h1>\n        <p class=\"project-heading2\">We don't just design; we create experiences. As a top interior design firm in India, our service range includes all needs:Residential interiors, Commercial Interiors, Luxury projects, Turnkey solutions, Renovations and Remodeling. </p>\n        <div class=\"container\">\n            <div class=\"image-grid\">\n                \n                <!-- Project Card 1: DR AK JAIN MODEL TOWN -->\n                <div class=\"project-card\">\n                    <div class=\"img-container\">\n                        <img width=\"986\" height=\"986\" decoding=\"async\" src=\"/img/project/dr-ak-jain-model-town/dr-ak-jain-model-town/2.avif\" alt=\"Dr AK Jain residence interior design in Model Town\" title=\"Dr AK Jain residence interior design in Model Town\">\n                    </div>\n                    <div class=\"project-info\">\n                        <!-- Example: Long title that might wrap to 2 lines -->\n                        <h2 class=\"project-title-name\">Dr. AK Jain</h2>\n                        <p>MODEL TOWN</p>\n                        <a title=\"View Dr AK Jain residence interior design project\" href=\"/chhattarpur/ak-jain-residence-interior-design\" class=\"view-more-button-link\">View More</a>\n                    </div>\n                </div>\n                \n                <!-- Project Card 2: Dr jain Karol Bagh -->\n                <div class=\"project-card\">\n                    <div class=\"img-container\">\n                        <img width=\"1648\" height=\"2500\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/dr-jain-karol-bagh/dr-jain-karol-bagh/2.avif\" alt=\"Dr Jain residence interior design in Karol Bagh\" title=\"Dr Jain residence interior design in Karol Bagh\">\n                    </div>\n                    <div class=\"project-info\">\n                         <!-- Example: Short title -->\n                        <h2 class=\"project-title-name\">Mr. Sandeep Jain </h2>\n                        <p>KAROL BAGH</p>\n                        <a title=\"View Dr Jain residence interior design project\" href=\"/chhattarpur/dr-jain-residence-interior-design\" class=\"view-more-button-link\">View More</a>\n                    </div>\n                </div>\n                \n                <!-- Project Card 3: Mr Alok Verma South X -->\n                <div class=\"project-card\">\n                    <div class=\"img-container\">\n                        <img width=\"2560\" height=\"1945\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-alok-verma-south-x/mr-alok-verma-south-x/2.avif\" alt=\"Mr Alok Verma residence interior design in South Extension\" title=\"Mr Alok Verma residence interior design in South Extension\">\n                    </div>\n                    <div class=\"project-info\">\n                        <h2 class=\"project-title-name\">Mr. Alok Verma </h2>\n                        <p>SOUTH X</p>\