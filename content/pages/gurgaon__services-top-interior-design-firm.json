me interior design Gurgaon,","theme-color":"#0f141f","canonical":"https://www.ninthcorner.in/gurgaon/services-top-interior-design-firm"},"jsonLd":["{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://www.ninthcorner.in/#organization\",\"name\":\"9th Corner\",\"alternateName\":[\"Ninth Corner\",\"9th-Corner\"],\"url\":\"https://www.ninthcorner.in/\",\"image\":\"https://www.ninthcorner.in/img/logo.avif\",\"logo\":\"https://www.ninthcorner.in/img/logo.avif\",\"description\":\"Create stylish, functional spaces with a top interior design firm in Gurgaon. Explore tailored residential and commercial interiors by Ninth Corner.\",\"telephone\":\"+91-9310582834\",\"email\":\"ninthcorner83@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Pearls Best Heights I, 808, Netaji Subhash Place, Pitampura\",\"addressLocality\":\"Delhi\",\"postalCode\":\"110034\",\"addressRegion\":\"Delhi\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Gurgaon\"},\"sameAs\":[\"https://www.facebook.com/ninthcornerINC\",\"https://www.instagram.com/9thcorner.interiors/\",\"https://www.linkedin.com/company/9th-corner-int/\",\"https://youtube.com/@9thcorner\"]}","{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.ninthcorner.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Gurgaon\",\"item\":\"https://www.ninthcorner.in/gurgaon/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Top Interior Design Firm in Gurgaon\",\"item\":\"https://www.ninthcorner.in/gurgaon/services-top-interior-design-firm\"}]}","{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.ninthcorner.in/#website\",\"name\":\"9th Corner\",\"alternateName\":\"Ninth Corner\",\"url\":\"https://www.ninthcorner.in/\",\"publisher\":{\"@id\":\"https://www.ninthcorner.in/#organization\"}}","{\"@con