n More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 30px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-family: var(--font-sans);\n            font-size: 16px;\n            font-weight: 600;\n            padding: 12px 36px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: var(--shadow-subtle);\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);\n        }\n\n        /* Work Gallery Carousel */\n        .work-gallery-section {\n            margin-top: 40px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        .gallery-card-content {\n            padding: 22px 20px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n        .gallery-card-content h3 {\n            font-size: 20px;\n            margin-bottom: 8px;\n            color: var(--heading-color);\n            line-height: 1.3;\n        }\n        .gallery-card-content p {\n            font-size: 14px;\n            line-height: 1.6;\n            margin: 0;\n            color: var(--text-color);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n                /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 3