padding: 0;\n            list-style: none;\n            max-width: 1100px;\n            margin: 0 auto 40px auto;\n        }\n        .reason-list li {\n            background-color: #ffffff;\n            color: var(--text-color);\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border: 1px solid #eee;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list li strong {\n            display: block;\n            color: var(--heading-color);\n            font-size: 1.1em;\n            margin-bottom: 8px;\n        }\n        .final-cta-message {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto;\n            font-size: 1.1em;\n            font-weight: 600;\n            color: var(--heading-color);\n            border-top: 2px solid var(--accent-color);\n            padding-top: 30px;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            padding: 40px 0 20px;\n        }\n        .faq-section h2 {\n            text-align: center;\n            font-size: 36px;\n            margin-bottom: 30px;\n            color: var(--heading-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background: #ffffff;\n            border-radius: var(--border-radius);\n            padding: 24px;\n            margin-bottom: 16px;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n        }\n        .faq-q {\n            font-family: var(--font-serif);\n            font-size: 20px;\n            font-weight: 700;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 30px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-family: var(--font-sans);\n            font-size: 16px;\n            font-weight: 600;\n            padding: 12px 36px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: var(--shadow-subtle);\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);\n        }\n\n        /* Work Gallery Carousel */\n        .work-gallery-section {\n            margin-top: 40px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        .gallery-card-content {\n            padding: 22px 20px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n        .gallery-card-content h3 {\n            font-size: 20px;\n            margin-bottom: 8px;\n            color: var(--heading-color);\n            line-height: 1.3;\n        }\n        .gallery-card-content p {\n            font-size: 14px;\n            line-height: 1.6;\n            margin: 0;\n            color: var(--text-color);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n                /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Interior Designer for Office in Noida</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            \n            <h2>Office Interior Design for Better Work, Comfort, and Teamwork</h2>\n            <p>An office should be more than a place where people sit and complete daily tasks. It should support focus, teamwork, comfort, and a positive work culture. As an <b>Interior Designer for Office in Noida</b>, we plan workspaces with these needs in mind. Whether in an office block or at a co-working station, each and every place is planned to ensure that more efficient use is made of the space available.</p>\n            <p>The office can represent the corporate image. Layout, furniture, lighting, colours and other design elements all influence how employees and clients see the business. As an office interior designer in Noida, we create design solutions that are business-friendly and support day-to-day processes.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Office Space Planning for Easy Movement and Better Work Areas</h2>\n            <p>Office space planning is an essential element when designing an office. With proper space planning, one will be able to have easy movement and ensure that all work areas are well connected without overcrowding the office. As an office interior designer, we develop optimized office plans taking into account the existing space and teamwork of staff members. This includes workstations, meeting rooms, communal areas, storage, among others.</p>\n            <p>The <b>office interior designer in Noida</b> must know that not all workplaces have the same needs. The corporate office might need private cabins, conference rooms, team rooms, and a reception area. The co-working office might need a flexible seating area and a common area.</p>\n        </div>\n\n        <!-- SERVICES GRID -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Comfort Through Ergonomic Design</h3>\n                <p>Employees spend long hours at their desks, so comfort matters throughout the working day. An office interior designer provides ergonomic furniture with good lighting for comfort. Well-designed furniture supports good posture and easy movement, and the right lighting reduces strain.</p><p>Our <b>commercial office interior design</b>&nbsp;approach also considers how people interact with the space. Comfortable workstations, common areas, and movement paths can help employees focus on their tasks. The goal is not to add unnecessary elements but to make every part of the office useful.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Design That Reflects Your brand</h3>\n                <p>An office can communicate a company&#39;s identity without using too many decorative elements. Brand colours, visual details, furniture, wall features, and other design elements can create a workspace connected to the business. Our office interior designer team develops brand-focused interiors that reflect the company&#39;s identity and culture while keeping the workplace professional.</p><p>For companies looking for <b>modern office interior designers in Noida</b>&nbsp;and <b>corporate</b>&nbsp;<b>office interior design in Noida</b>, the focus should be on balancing appearance with everyday use. <b>Interior Designer for Office in noida</b>&nbsp; should provide practical work areas, suitable lighting, comfortable seating, and enough space for people to work and interact.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Complete Planning for Your Workspace</h3>\n                <p>Office projects involve many decisions, so proper planning is important. As an interior designer for office projects in Noida, we offer customized solutions based on workspace requirements and manage the project from design through completion. This keeps different parts of the project connected and makes the process easier for the client.</p><p>Our <b>customized office interior design services</b>&nbsp;are planned around the size, purpose, and working style of each office. We do not use one fixed layout. The design suits the business, area, and needs of people using it.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Why a Well-Planned Office Matters</h3>\n                <p>A thoughtfully designed workplace can support better space use, comfortable working conditions, and a stronger professional image. It can also create an environment where employees feel comfortable and visitors receive a positive impression. Good design brings these needs together without making the space difficult to use.</p><p>When the layout, furniture, lighting and branding work together, the office feels organised without becoming complicated. This helps day-to-day work and supports the goals of the business. Whether it is a corporate office or a co-working space, the planning should begin with people and the work they need to do.</p>\n            </div>\n        </div>\n\n\n        <!-- FAQS -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What makes a good office interior?</h3>\n                    <p class=\"faq-a\">An exceptional office interior combines useful planning, comfortable furniture, appropriate lighting, easy movement and design elements that fit the company.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Do you design corporate and co-working offices?</h3>\n                    <p class=\"faq-a\">Yes. Design can be adjusted for corporate offices, co-working spaces, and other workplaces.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can the design reflect our company brand?</h3>\n                    <p class=\"faq-a\">Yes. An office interior designer can use brand colours, visual details, furniture and chosen design elements to create a workspace that reflects the identity and culture of the company.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">How do you improve space utilization?</h3>\n                    <p class=\"faq-a\">We study the area and how employees use it before planning workstations, meeting rooms, storage, common areas, and other zones.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can interior design services be selected for different types of spaces?</h3>\n                    <p class=\"faq-a\">Yes, interior design services are available for various residential and commercial spaces. Services can be chosen based on the purpose and requirements of each project.</p>\n                </div>\n            </div>\n            <div class=\"learn-more-wrap\">\n                <a href=\"https://www.ninthcorner.in/noida/services\" class=\"learn-more-btn\">Learn More</a>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects in Noida</h2>\n                <p>Showcasing our completed residential and commercial spaces designed with excellence.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                                        <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-anand-kumar-noida/mr-anand-kumar-noida/519.avif\" alt=\"Luxury residential interior project in Noida by Ninth Corner\" title=\"Luxury Residential Interior\">\n                            </div>\n                        </div>\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-rana-noida/mr-rana-noida/10.avif\" al