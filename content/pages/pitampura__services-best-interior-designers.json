"theme-color":"#0f141f","canonical":"https://www.ninthcorner.in/pitampura/services-best-interior-designers"},"jsonLd":["{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://www.ninthcorner.in/#organization\",\"name\":\"9th Corner\",\"alternateName\":[\"Ninth Corner\",\"9th-Corner\"],\"url\":\"https://www.ninthcorner.in/\",\"image\":\"https://www.ninthcorner.in/img/logo.avif\",\"logo\":\"https://www.ninthcorner.in/img/logo.avif\",\"description\":\"As one of the best interior designers in Pitampura, we specialize in transforming ordinary spaces into extraordinary experiences. Our mission is simple: to combine creativity, functionality, and elegance to deliver interiors that are not only visually stunning but also highly\",\"telephone\":\"+91-9310582834\",\"email\":\"ninthcorner83@gmail.com\",\"priceRange\":\"$$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Pearls Best Heights I, 808, Netaji Subhash Place, Pitampura\",\"addressLocality\":\"Delhi\",\"postalCode\":\"110034\",\"addressRegion\":\"Delhi\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Pitampura\"},\"sameAs\":[\"https://www.facebook.com/ninthcornerINC\",\"https://www.instagram.com/9thcorner.interiors/\",\"https://www.linkedin.com/company/9th-corner-int/\",\"https://youtube.com/@9thcorner\"]}","{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.ninthcorner.in/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Pitampura\",\"item\":\"https://www.ninthcorner.in/pitampura/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Best Interior Designers in Pitampura\",\"item\":\"https://www.ninthcorner.in/pitampura/services-best-interior-designers\"}]}","{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.ninthcorner.in/#website\",\"name\":\"9th Corner\",\"alternateName\":\"Ninth Corner\",\"url\":\"https://www.ninthcorner.in/\",\"publisher\":{\"@id\":\"https://www.ninthcorner.in/#organization\"}}","{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who are the best interior designers near Pitampura?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Look for a team with finished local projects, clear drawings and real site supervision. Our head office is at Netaji Subhash Place, and you can meet us there to review past work.\"}},{\"@type\":\"Question\",\"name\":\"Do you design builder floors in North West Delhi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We design builder floors and apartments in Pitampura, Rohini, Shalimar Bagh, Model Town and nearby areas.\"}},{\"@type\":\"Question\",\"name\":\"Can you design a home while the family is living in it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We plan the work room by room so the family can keep living in the house, with dust and noise kept under control.\"}},{\"@type\":\"Question\",\"name\":\"Why do clients call us among the best interior designers in the area?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Because we plan carefully, stay reachable and supervise the work until handover, so there are fewer surprises on site.\"}}]}","{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Best Interior Designers in Pitampura, Delhi\",\"serviceType\":\"Best Interior Designers\",\"description\":\"Work with the best interior designers in Pitampura. 9th Corner plans, designs and builds homes and offices that look beautiful every day.\",\"url\":\"https://www.ninthcorner.in/pitampura/services-best-interior-designers\",\"provider\":{\"@id\":\"https://www.ninthcorner.in/#organization\"},\"areaServed\":{\"@type\":\"Place\",\"name\":\"Pitampura, Delhi\"}}"],"preloads":[],"html":"<!-- CITY-EXPANSION -->\n    <style>\n        /* New Warm & Elegant Theme Colors */\n        :root {\n            --bg-color: #f4f1ee; /* Warm Off-White */\n            --text-color: #5a5349; /* Warm Gray/Brown Body Text */\n            --heading-color: #4a433a; /* Darker Warm Gray/Brown Headings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        .container {\n            width: 100%;\n            padding: 0 20px;\n            box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400;\n            color: var(--text-color);\n        }\n        b, strong {\n            font-weight: 700;\n            color: var(--heading-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n            background-image: url('/img/bb1.avif'); \n            background-size: cover;\n            background-position: center center;\n            position: relative; \n            overflow: hidden;\n            min-height: 400px;\n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1;\n        }\n        \n        .hero-section::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(30px, 5.5vw, 54px);\n            font-weight: 700;\n            margin-bottom: 0;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .intro-text h2 {\n            font-size: clamp(26px, 3.5vw, 36px);\n            margin-bottom: 20px;\n            color: var(--heading-color);\n            line-height: 1.25;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width,\n        .service-card:nth-child(3),\n        .service-card:nth-child(4) {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n        }\n        .service-card h3 {\n            font-size: 24px;\n            margin-bottom: 15px;\n            color: var(--heading-color);\n        }\n        .service-card p {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 10px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n        .service-card ul {\n            padding-left: 20px;\n            margin: 10px 0;\n        }\n        .service-card li {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 6px;\n            color: var(--text-color);\n        }\n\n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            margin-bottom: 50px;\n        }\n        .why-choose-us h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--accent-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px;\n            font-size: 16px;\n        }\n        .why-choose-intro p {\n            margin-bottom: 10px;\n        }\n        .reason-list {\n            list-style: none;\n            padding: 0;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n        }\n        .reason-list li {\n            background: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border-left: 5px solid var(--accent-color);\n            font-size: 15px;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n            color: var(--heading-color);\n        }\n        .final-cta-message {\n            margin-top: 30px;\n            text-align: center;\n            font-style: italic;\n            font-size: 15px;\n            color: var(--heading-color);\n        }\n        .final-cta-message a {\n            color: var(--accent-color);\n            text-decoration: underline;\n            font-weight: 600;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            margin-bottom: 50px;\n        }\n        .faq-section h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 30px;\n            color: var(--accent-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-bottom: 15px;\n        }\n        .faq-q {\n            font-size: 18px;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 20px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            padding: 14px 38px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(139, 129, 115, 0.3);\n            letter-spacing: 0.5px;\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(74, 67, 58, 0.4);\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Best Interior Designers in Pitampura, Delhi</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            <h2>Choosing a Designer for Your Pitampura Home</h2>\n            <p>Recognized as the best interior designers in Pitampura, Delhi, we create spaces that leave a lasting impression of sophistication and grace. Every project is approached with creativity, precision, and a relentless attention to detail. Whether it’s a cozy family home, a high-performance office, or a luxury showroom, our designs seamlessly blend aesthetics, comfort, and uncompromising functionality.</p>\n            <p>Pitampura families tend to do their homework. They ask relatives for names, visit finished homes and compare quotes in detail before choosing the best interior designers for the job. That careful approach makes sense, because a good designer can save money and stress, while a poor one can cost both.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Personalized Designs for Every Client</h2>\n            <p>\"We prioritize understanding your lifestyle, brand identity, and aesthetic preferences to craft interiors that truly resonate. From initial conceptualization to final site execution, we ensure each space is customized, practical, and visually stunning, setting new benchmarks for design excellence in North Delhi.\"</p>\n        </div>\n\n        <!-- SERVICE CATEGORIES GRID (4 CARDS) -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Kothis and Builder Floors</h3>\n                <p>For an independent floor or house, we design every room around the family's routine: a kitchen with space for daily cooking and festival feasts, a dining area that can seat visiting relatives, bedrooms with enough wardrobe space and a living room that works for both guests and TV evenings.</p><p>Puja rooms, study corners and shoe storage are planned, not squeezed in later.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>DDA Flats and Apartments</h3>\n                <p>In DDA and society flats, space is limited and walls cannot always move. The best interior designers make these homes feel larger through smart storage, lighter colours, sliding doors and furniture made to fit each room exactly.</p><p>We also handle common upgrades like kitchen replacement, bathroom renovation and new electrical wiring.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>How to Judge a Designer</h3>\n                <p>Look at their finished homes, not just their renders. Ask who will supervise your site and how often. Check what brands of plywood, laminate, hardware and paint are included in the quote. Ask how changes are handled once work begins. A good firm will answer clearly and put it in writing. We are happy to arrange visits to completed homes in nearby areas.</p><p><b>Client-Focused Strategy:</b> The best interior designers make your vision the foundation of every room, creating personalized narratives that reflect your individual taste.</p><p><b>Innovative Materiality:</b> A bold use of space, architectural lighting, and sustainable materials that maximize both visual impact and everyday utility.</p><p><b>Stylish Functionality:</b> Crafting high-end interiors that don't just look beautiful on camera but work effortlessly for your daily routine or business workflow.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Working Together, Step by Step</h3>\n                <p>We start at your home, measuring every room and listening to each family member. A layout, colour ideas and 3D views follow. Once you are happy, we fix materials and a written budget.</p><p>Our site supervisor manages carpenters, electricians and painters, and you get updates throughout. The best interior designers finish what they promise, and that is how we measure ourselves.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>What You Should Expect From the Best Interior Designers</h2>\n            <div class=\"why-choose-intro\">\n                <p>Trust is earned through clear work. We put everything in writing, share regular site photos and keep our word on dates.</p>\n            </div>\n            <ul class=\"reason-list\">\n                <li>\n                    <strong>Vast Experience in Premium Residential & Commercial Architecture</strong>\n                    Many years of residential and commercial work in Delhi.\n                </li>\n                <li>\n                    <strong>Creative Solutions Precision-Tailored to Your Spatial Requirements</strong>\n                    Ideas matched to your room sizes and daily needs.\n                </li>\n                <li>\n                    <strong>Seamless Execution and Turnkey Delivery with Elite Finishes</strong>\n                    Careful execution, from carcass to final polish.\n                </li>\n                <li>\n                    <strong>Brand List in Every Quote</strong>\n                    You know exactly which materials you are paying for.\n                </li>\n                <li>\n                    <strong>Visits to Finished Homes</strong>\n                    See our work before you decide.\n                </li>\n            </ul>\n            <div class=\"final-cta-message\">\n                <p>Ready to set a new standard for your space? Partner with the best interior specialists in Pitampura to bring your vision to life.</p>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects Near Pitampura</h2>\n                <p>Homes finished by our team in Model Town and Ashok Vihar.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                    <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-arun-ashok-vihar/mr-arun-ashok-vihar/3.avif\" alt=\"Living room in Ashok Vihar, Delhi by 9th Corner\" title=\"Ashok Vihar Living Room\">\n                            </div>\n                        </div>\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/dr-ak-jain-model-town/dr-ak-jain-model-town/51.avif\" alt=\"Interior project in Model Town, Delhi by 9th Corner\" title=\"Model Town Interior\">\n                            </div>\n                        </div>\n                        <div class=\