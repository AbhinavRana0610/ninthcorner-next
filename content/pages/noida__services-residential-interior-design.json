    }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        .gallery-card-content {\n            padding: 22px 20px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n        .gallery-card-content h3 {\n            font-size: 20px;\n            margin-bottom: 8px;\n            color: var(--heading-color);\n            line-height: 1.3;\n        }\n        .gallery-card-content p {\n            font-size: 14px;\n            line-height: 1.6;\n            margin: 0;\n            color: var(--text-color);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n                /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Residential Interior Design in Noida</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            \n            <h2>Residential Interior Design for Comfortable and Personalized Homes</h2>\n            <p>A house should be more than a place where a family lives. It should feel comfortable, useful, personal and welcoming. Our <b>Residential Interior Design in Noida </b>focuses on spaces that match the lifestyle, personality and comfort needs of your family.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Residential Interior Architect for Personalized and Comfortable Family Spaces</h2>\n            <p>Every family has a different lifestyle, and the design should start from it. Good residential interior design responds to this naturally and personally. One approach is to hire a <b>residential interior architect in Noida</b>. They look at how you move through the home, your daily routine, how each room is used and the look you prefer. This creates an interior that feels personal and suits everyday life.</p>\n            <p>Living rooms, kitchens, bedrooms and study areas each need a different layout. In residential interior design, a living space should be open and well-lit for families and guests. A kitchen needs a simple arrangement, useful storage and enough workspace. Bedrooms should feel calm and private, while a study should support focused work.</p>\n        </div>\n\n        <!-- SERVICES GRID -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Smart Planning for Every Corner</h3>\n                <p>Spatial planning is at the heart of residential interior design. A full layout helps people move easily and allows you to customize furniture, storage, and decor naturally. With careful planning, even a small apartment can feel more open if its available space is used wisely.</p><p>As a <b>residential interior design</b> studio in Noida, we focus on practical layouts to make day-to-day living easier, with furniture placement, storage, lighting, colours and decor planned together. This creates a balanced home where every area has a clear purpose.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Design That Matches Your Lifestyle</h3>\n                <p>A modern home should support the way its owners live. Some families need more storage, while others want more space to spend time together. These details matter, because a beautiful home is only useful if it works well for the people who live in it.</p><p>Modern <b>residential interior design in Noida</b>&nbsp;can include clean layouts, smart storage, minimalist furniture, suitable lighting, and carefully selected surfaces. The aim is to combine current ideas with choices that will still work well over time.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>From First Idea to Final Space</h3>\n                <p>A smooth design process starts with understanding the home and the people who live in it. Our team evaluates the available space, discusses your requirements, and develops design themes that balance style and functionality, making implementation simpler and more effective.</p><p>Every decision should follow the overall vision for the home, and an experienced <b>residential interior design firm in Noida</b>&nbsp;can guide clients through important design decisions and execution steps.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Why Choose a Professional Design Team?</h3>\n                <p>A professional team brings experience, planning, and attention to detail. In residential interior design, it can understand the needs of the family and turn them into a practical plan. From concept to execution, clear planning keeps the work consistent and the project on track.</p><p>For a home theatre or media room, an <b>interior architect</b> in Noida can help plan the space, furniture, equipment, lighting, colours and fabrics. With the right advice, owners can make better decisions and avoid mistakes that don&rsquo;t work well in everyday life.</p>\n            </div>\n        </div>\n\n\n        <!-- FAQS -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Do you offer a variety of interior design services?</h3>\n                    <p class=\"faq-a\">Yes, a variety of interior design services are available for different types of spaces. The right service can be selected according to the project&rsquo;s specific needs.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can you design apartments and villas?</h3>\n                    <p class=\"faq-a\">Yes. Our residential interior design in Noida plans each property according to its size, layout, family requirements, and preferred style.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Can small homes have a stylish interior?</h3>\n                    <p class=\"faq-a\">Yes. Smart layouts, suitable furniture, useful storage, and good lighting can make smaller homes feel comfortable.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">How is the design made personal?</h3>\n                    <p class=\"faq-a\">The design is based on the family&rsquo;s lifestyle, preferences, daily needs, and the way each room will be used.</p>\n                </div>\n            </div>\n            <div class=\"learn-more-wrap\">\n                <a href=\"https://www.ninthcorner.in/noida/services.php\" class=\"learn-more-btn\">Learn More</a>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects in Noida</h2>\n                <p>Showcasing our completed residential and commercial spaces designed with excellence.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                                        <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-anand-kumar-noida/mr-anand-kumar-noida/519.avif\" alt=\"Luxury residential interior project in Noida by Ninth Corner\" title=\"Luxury Residential Interior\">\n                            </