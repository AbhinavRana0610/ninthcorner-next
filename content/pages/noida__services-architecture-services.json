-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-weight: 500;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s, box-shadow 0.3s;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);\n        }\n        .service-card h3 {\n            color: var(--accent-color);\n            font-size: 26px;\n            margin-bottom: 15px;\n        }\n        .service-card p {\n            margin-bottom: 12px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Why Choose Us (Checklist) --- */\n        .why-choose-us {\n            padding: 40px 0;\n        }\n        .why-choose-us h2 {\n            text-align: center;\n            font-size: 40px;\n            margin-bottom: 20px;\n            color: var(--heading-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px auto;\n            font-size: 1.05em;\n        }\n        .reason-list {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n            gap: 20px;\n            padding: 0;\n            list-style: none;\n 