ry-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        .gallery-card-content {\n            padding: 22px 20px;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n        }\n        .gallery-card-content h3 {\n            font-size: 20px;\n            margin-bottom: 8px;\n            color: var(--heading-color);\n            line-height: 1.3;\n        }\n        .gallery-card-content p {\n            font-size: 14px;\n            line-height: 1.6;\n            margin: 0;\n            color: var(--text-color);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n\n    \n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Architecture Services in Noida</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            \n            <h2>Professional Architecture Services for Practical and Well-Planned Spaces</h2>\n            <p>Great architecture starts with a clear idea of how a space should look and work. <b>Architecture Services in Noida</b>&nbsp;can help turn that idea right into an organized space that is practical and ready for long-term use. A strong design should not focus only on appearance. It should consider comfort, movement, framework, light, materials, and the needs of people who will utilize it.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Modern Architectural Services for Creative and Practical Spaces</h2>\n            <p>Modern architecture needs a balance between creative design and practical planning. <b>Architectural services in Noida</b> should combine these two sides together. We plan spaces for residential, commercial, and institutional projects according to their purpose and requirements. Each property has different needs, so its layout and technical details should be planned accordingly.</p>\n            <p>Sustainability is also an important part of present-day design. Eco-friendly ideas can create spaces that are useful today and ready for the future. Our architecture services focus on smart planning while keeping the project practical. This approach helps create buildings that remain useful, comfortable, and appealing.</p>\n        </div>\n\n        <!-- SERVICES GRID -->\n        <div class=\"services-grid\">\n            <div class=\"service-card full-width\">\n                <h3>Complete Architectural Design Under One Process</h3>\n                <p>A successful project needs more than a basic drawing. An <b>architectural design company in Noida</b>&nbsp;can support this work. Architectural design can include planning, <b>3D visualization, structural design</b>, and project management. These stages bring the idea together before construction. With proper planning, clients can understand the space and how different parts will work together.</p><p>Our <b>architectural design services in Noida</b>&nbsp;cover different project types and can suit specific needs. Residential architecture services in Noida may need comfortable layouts and practical room planning. Commercial Noida Architecture Services &nbsp;may require clear movement, useful work areas, and a design supporting daily business activity. Institutional projects can have their own space and functional requirements. Each project receives attention based on its purpose for every type of property.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>See The Design Before Construction</h3>\n                <p>As part of our architecture services, 3D visualization makes it easier to understand a project before construction begins. Instead of depending only on drawings, clients can get a clearer view of the design. This helps them review the space and refine ideas.</p><p>3D modeling also supports better communication between the client and the design team. When the planned structure and spaces are easier to see, decisions become clearer. It gives the project direction before physical work starts.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Why Thoughtful Architecture Matters</h3>\n                <p>Good architectural planning can make a major difference to the final result. <b>Experienced architects</b>&nbsp;can understand project needs and develop suitable solutions. A tailored design can support functional and visual requirements instead of using one approach for every property.</p><p>Project management is another important part of our architecture services in Noida. From concept to completion, careful coordination keeps every stage connected and makes the process easier to follow. Planning, technical knowledge, and creative thinking work together to create a complete service.</p>\n            </div>\n        </div>\n\n\n        <!-- FAQS -->\n        <section class=\"faq-section\">\n            <h2>Frequently Asked Questions</h2>\n            <div class=\"faq-list\">\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">What kinds of projects can architectural services cover?</h3>\n                    <p class=\"faq-a\">Services provided by an architect could be for residences, businesses, and institutions. This is determined by the need, size, and use of the building.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Are there different interior design services for various spaces?</h3>\n                    <p class=\"faq-a\">Yes,<b>&nbsp;interior design services </b>can be planned for residential and commercial spaces. The service options can be adjusted according to the use and layout of the space.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">How does 3D visualization help?</h3>\n                    <p class=\"faq-a\">3D visualization helps clients see and understand the proposed project before construction starts. It also gives them an opportunity to review the design and refine ideas.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Are sustainable solutions part of architectural planning?</h3>\n                    <p class=\"faq-a\">Yes. The concept of sustainable design is based upon solutions which are environmentally friendly and useful for sustaining the use of the building in the future.</p>\n                </div>\n                <div class=\"faq-item\">\n                    <h3 class=\"faq-q\">Why is project management important?</h3>\n                    <p class=\"faq-a\">Project management helps connect different stages of the work, from concept to completion. It supports coordination and keeps the project organised.</p>\n                </div>\n            </div>\n            <div class=\"learn-more-wrap\">\n                <a href=\"https://www.ninthcorner.in/noida/services\" class=\"learn-more-btn\">Learn More</a>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects in Noida</h2>\n                <p>Showcasing our completed residential and commercial spaces designed with excellence.</p>\n            </div>\n            <div class