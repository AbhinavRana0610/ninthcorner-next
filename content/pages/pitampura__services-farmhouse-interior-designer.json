CITY-EXPANSION -->\n    <style>\n        /* New Warm & Elegant Theme Colors */\n        :root {\n            --bg-color: #f4f1ee; /* Warm Off-White */\n            --text-color: #5a5349; /* Warm Gray/Brown Body Text */\n            --heading-color: #4a433a; /* Darker Warm Gray/Brown Headings */\n            --accent-color: #8b8173; /* Muted Khaki/Taupe Accent */\n            --font-serif: 'Cormorant Garamond', serif;\n            --font-sans: 'Montserrat', sans-serif;\n\n            /* Existing non-color variables kept for structure */\n            --shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);\n            --border-radius: 12px;\n        }\n\n        /* General Styles */\n        body {\n            font-family: var(--font-sans);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        .container {\n            width: 100%;\n            padding: 0 20px;\n            box-sizing: border-box;\n        }\n        h1, h2, h3 {\n            font-family: var(--font-serif);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-top: 0;\n            color: var(--heading-color);\n        }\n        p {\n            font-weight: 400;\n            color: var(--text-color);\n        }\n        b, strong {\n            font-weight: 700;\n            color: var(--heading-color);\n        }\n        section {\n            padding: 60px 0;\n        }\n        \n        /* --- Hero Section --- */\n        .hero-section {\n            background-image: url('/img/tra5.avif'); \n            background-size: cover;\n            background-position: center center;\n            position: relative; \n            overflow: hidden;\n            min-height: 400px;\n            color: var(--bg-color);\n            padding: 80px 20px 60px;\n            border-bottom-left-radius: 40px;\n            border-bottom-right-radius: 40px;\n            text-align: center;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            z-index: 1;\n        }\n        \n        .hero-section::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            z-index: 2;\n        }\n        \n        .hero-section .container {\n            position: relative;\n            z-index: 3;\n        }\n\n        .hero-section h1 {\n            font-size: clamp(30px, 5.5vw, 54px);\n            font-weight: 700;\n            margin-bottom: 0;\n            color: var(--bg-color);\n            text-shadow: none;\n        }\n\n        /* --- Content & Philosophy --- */\n        .content-wrap {\n            padding: 40px 0;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n        .intro-text, .philosophy-box {\n            margin-bottom: 50px;\n        }\n        .intro-text h2 {\n            font-size: clamp(26px, 3.5vw, 36px);\n            margin-bottom: 20px;\n            color: var(--heading-color);\n            line-height: 1.25;\n        }\n        .philosophy-box {\n            background-color: var(--bg-color);\n            border: 2px solid var(--accent-color);\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            text-align: center;\n        }\n        .philosophy-box h2 {\n            font-size: 32px;\n            margin-bottom: 15px;\n            color: var(--accent-color);\n        }\n        .philosophy-box p {\n            font-style: italic;\n            font-weight: 600;\n            color: var(--text-color);\n            margin-bottom: 15px;\n        }\n        .philosophy-box p:last-child {\n            margin-bottom: 0;\n        }\n\n        /* --- Services Grid --- */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 50px;\n        }\n        .service-card.full-width,\n        .service-card:nth-child(3),\n        .service-card:nth-child(4) {\n            grid-column: 1 / -1;\n        }\n        .service-card {\n            background-color: #ffffff;\n            padding: 30px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n        }\n        .service-card h3 {\n            font-size: 24px;\n            margin-bottom: 15px;\n            color: var(--heading-color);\n        }\n        .service-card p {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 10px;\n        }\n        .service-card p:last-child {\n            margin-bottom: 0;\n        }\n        .service-card ul {\n            padding-left: 20px;\n            margin: 10px 0;\n        }\n        .service-card li {\n            font-size: 15px;\n            line-height: 1.6;\n            margin-bottom: 6px;\n            color: var(--text-color);\n        }\n\n        /* --- Why Choose Us --- */\n        .why-choose-us {\n            margin-bottom: 50px;\n        }\n        .why-choose-us h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--accent-color);\n        }\n        .why-choose-intro {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 30px;\n            font-size: 16px;\n        }\n        .why-choose-intro p {\n            margin-bottom: 10px;\n        }\n        .reason-list {\n            list-style: none;\n            padding: 0;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n        }\n        .reason-list li {\n            background: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            border-left: 5px solid var(--accent-color);\n            font-size: 15px;\n            box-shadow: var(--shadow-subtle);\n        }\n        .reason-list strong {\n            display: block;\n            margin-bottom: 5px;\n            font-size: 16px;\n            color: var(--heading-color);\n        }\n        .final-cta-message {\n            margin-top: 30px;\n            text-align: center;\n            font-style: italic;\n            font-size: 15px;\n            color: var(--heading-color);\n        }\n        .final-cta-message a {\n            color: var(--accent-color);\n            text-decoration: underline;\n            font-weight: 600;\n        }\n\n        /* --- FAQ Section --- */\n        .faq-section {\n            margin-bottom: 50px;\n        }\n        .faq-section h2 {\n            font-size: 32px;\n            text-align: center;\n            margin-bottom: 30px;\n            color: var(--accent-color);\n        }\n        .faq-list {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n        .faq-item {\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-bottom: 15px;\n        }\n        .faq-q {\n            font-size: 18px;\n            color: var(--heading-color);\n            margin-bottom: 10px;\n        }\n        .faq-a {\n            font-size: 15px;\n            color: var(--text-color);\n            line-height: 1.6;\n            margin: 0;\n        }\n\n        /* Learn More Button */\n        .learn-more-wrap {\n            text-align: center;\n            margin-top: 35px;\n            margin-bottom: 20px;\n        }\n        .learn-more-btn {\n            display: inline-block;\n            background-color: var(--accent-color);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            padding: 14px 38px;\n            border-radius: 30px;\n            text-decoration: none;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(139, 129, 115, 0.3);\n            letter-spacing: 0.5px;\n        }\n        .learn-more-btn:hover {\n            background-color: var(--heading-color);\n            color: #ffffff;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(74, 67, 58, 0.4);\n        }\n\n        /* --- Closing Section --- */\n        .closing-section {\n            padding: 40px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid #eee;\n            margin-top: 30px;\n            text-align: center;\n        }\n        .closing-section h2 {\n            font-size: 32px;\n            color: var(--accent-color);\n            margin-bottom: 15px;\n        }\n        .closing-section p {\n            max-width: 900px;\n            margin: 0 auto 15px;\n            font-size: 16px;\n            line-height: 1.7;\n        }\n        .closing-section p a {\n            color: var(--accent-color);\n            font-weight: 600;\n            text-decoration: underline;\n        }\n\n        /* --- Work Done / Project Showcase Gallery Carousel --- */\n        .work-gallery-section {\n            margin-top: 50px;\n            margin-bottom: 50px;\n            position: relative;\n            overflow: hidden;\n        }\n        .gallery-header {\n            text-align: center;\n            margin-bottom: 35px;\n            padding: 0 20px;\n        }\n        .gallery-header h2 {\n            font-size: clamp(26px, 4vw, 36px);\n            margin-bottom: 12px;\n            color: var(--heading-color);\n        }\n        .gallery-header p {\n            font-size: 16px;\n            max-width: 750px;\n            margin: 0 auto;\n            color: var(--text-color);\n        }\n        .gallery-carousel-wrapper {\n            width: 100%;\n            overflow: hidden;\n            position: relative;\n            padding: 15px 0 25px;\n            -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n            mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);\n        }\n        .gallery-carousel-track {\n            display: flex;\n            width: max-content;\n            animation: infiniteGalleryScroll 30s linear infinite;\n            will-change: transform;\n        }\n        .gallery-carousel-wrapper:hover .gallery-carousel-track,\n        .gallery-carousel-wrapper:active .gallery-carousel-track {\n            animation-play-state: paused;\n        }\n        .gallery-carousel-group {\n            display: flex;\n            gap: 25px;\n            padding-right: 25px;\n            flex-shrink: 0;\n        }\n        .gallery-card {\n            width: 320px;\n            max-width: 340px;\n            background-color: #ffffff;\n            border-radius: var(--border-radius);\n            overflow: hidden;\n            box-shadow: var(--shadow-subtle);\n            border: 1px solid rgba(139, 129, 115, 0.2);\n            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\n            display: flex;\n            flex-direction: column;\n            flex-shrink: 0;\n        }\n        .gallery-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);\n            border-color: var(--accent-color);\n        }\n        .gallery-img-wrap {\n            width: 100%;\n            height: 240px;\n            overflow: hidden;\n            position: relative;\n            background-color: #e5e0d8;\n            border-radius: inherit;\n        }\n        .gallery-img-wrap img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n            transition: transform 0.6s ease;\n        }\n        .gallery-card:hover .gallery-img-wrap img {\n            transform: scale(1.08);\n        }\n        @keyframes infiniteGalleryScroll {\n            0% {\n                transform: translate3d(0, 0, 0);\n            }\n            100% {\n                transform: translate3d(-25%, 0, 0);\n            }\n        }\n        @media (prefers-reduced-motion: reduce) {\n            .gallery-carousel-track {\n                animation: none;\n            }\n            .gallery-carousel-wrapper {\n                overflow-x: auto;\n                -webkit-mask-image: none;\n                mask-image: none;\n            }\n        }        /* Mobile Responsiveness */\n        @media (max-width: 767px) {\n            .hero-section {\n                padding: 60px 16px 40px;\n                border-radius: 0;\n            }\n            .content-wrap.container {\n                padding-left: 0;\n                padding-right: 0;\n                padding-top: 25px;\n                padding-bottom: 25px;\n            }\n            .intro-text {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 35px;\n            }\n            .intro-text h2 {\n                font-size: clamp(1.6rem, 6.5vw, 2.1rem);\n                line-height: 1.22;\n                margin-bottom: 16px;\n            }\n            .intro-text p {\n                font-size: 16px;\n                line-height: 1.7;\n                margin-bottom: 15px;\n            }\n            .philosophy-box {\n                width: calc(100% - 32px);\n                max-width: 100%;\n                margin-left: auto;\n                margin-right: auto;\n                padding: 26px 16px;\n                border-radius: 16px;\n                box-sizing: border-box;\n                overflow: hidden;\n                margin-bottom: 40px;\n            }\n            .philosophy-box h2 {\n                margin: 0 0 22px;\n                text-align: center;\n                font-size: clamp(1.85rem, 7vw, 2.25rem);\n                line-height: 1.18;\n                overflow-wrap: break-word;\n            }\n            .philosophy-box p {\n                width: 100%;\n                margin: 0 0 20px;\n                padding: 0;\n                text-align: left;\n                text-indent: 0;\n                font-size: 17px;\n                line-height: 1.7;\n                overflow-wrap: break-word;\n                word-break: normal;\n                hyphens: none;\n            }\n            .philosophy-box p:last-child {\n                margin-bottom: 0;\n            }\n            .services-grid {\n                grid-template-columns: 1fr;\n                gap: 20px;\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                margin-bottom: 40px;\n            }\n            .why-choose-us,\n            .faq-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n            }\n            .gallery-card {\n                width: 280px;\n            }\n            .gallery-img-wrap {\n                height: 200px;\n            }\n            .gallery-carousel-group {\n                gap: 18px;\n                padding-right: 18px;\n            }\n            .gallery-carousel-track {\n                animation-duration: 22s;\n            }\n            .closing-section {\n                width: calc(100% - 32px);\n                margin-left: auto;\n                margin-right: auto;\n                box-sizing: border-box;\n                padding: 25px 16px;\n                border-radius: 16px;\n            }\n            .process-card-row {\n                flex-direction: column;\n            }\n        }\n\n        @media (min-width: 481px) and (max-width: 767px) {\n            .intro-text,\n            .philosophy-box,\n            .services-grid,\n            .why-choose-us,\n            .faq-section,\n            .closing-section {\n                width: calc(100% - 40px);\n            }\n        }\n    </style>\n\n    <!-- HERO SECTION -->\n    <section class=\"hero-section\">\n        <div class=\"container\">\n            <h1>Farmhouse Interior Designer in Pitampura, Delhi</h1>\n        </div>\n    </section>\n\n    <!-- MAIN CONTENT WRAPPER -->\n    <div class=\"container content-wrap\">\n\n        <!-- INTRO -->\n        <div class=\"intro-text\">\n            <h2>Farmhouses on the GT Karnal Road Belt</h2>\n            <p>We specialize in farmhouse interiors that masterfully blend rustic charm with contemporary luxury. As a farmhouse interior designer in Pitampura, Delhi, we focus on creating relaxing, elegant, and functional retreats that harmonize with nature while providing all the sophisticated amenities of a modern residence. We turn expansive plots into private sanctuaries of timeless style.</p>\n            <p>Many Pitampura families own farmhouses in the North Delhi belt along GT Karnal Road, around Alipur, Bakoli and Narela. These properties are close enough for a Sunday visit and big enough for family functions. As a farmhouse interior designer, we help owners turn them into comfortable second homes rather than empty plots with a single room.</p>\n        </div>\n\n        <!-- PHILOSOPHY / SERVICE OVERVIEW -->\n        <div class=\"philosophy-box\">\n            <h2>Personalized Farmhouse Interiors</h2>\n            <p>\"We design cozy, oversized living areas, open-concept gourmet kitchens, and serene master suites that prioritize light and air. By integrating natural materials and earthy tones, we create a seamless indoor-outdoor transition that defines the quintessential farmhouse lifestyle.\"</p>\n        </div>\n\n        <!-- SERVICE CATEGORIES GRID (4 CARDS) -->\n        <div class=\"services-grid\">\n            <div class=\"service-card\">\n                <h3>Weekend Homes for Family Gatherings</h3>\n                <p>Most farmhouses here are used on weekends and festivals. We design a large living and dining space that can seat the extended family, a kitchen that can handle cooking for many, and a few bedrooms for those who stay overnight. Furniture is comfortable but sturdy, since it may be used by children, elders and guests all at once.</p><p>Lockable storage keeps valuables safe when the house is empty during the week.</p><p>A covered sit-out next to the kitchen lets the family eat outdoors even in the afternoon sun.</p>\n            </div>\n            <div class=\"service-card\">\n                <h3>Function Lawns and Outdoor Rooms</h3>\n                <p>Birthdays, kitty parties and pre-wedding events often move to the farm. A farmhouse interior designer plans the lawn, gazebo, outdoor kitchen, toilets and parking so these events run smoothly, with enough power points and lighting for tents, music and catering.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>Built for Part-Time Use</h3>\n                <p>A house that is shut most of the week needs good security, strong locks, simple alarms and lighting on timers. Finishes should resist dust and damp, since rooms may stay closed for days. Ceiling fans, cross-ventilation and shaded verandas help the house cool down quickly when the family arrives. Solar panels and inverter backup reduce dependence on the local supply.</p><p>Hand pumps, a water tank on a stand and a simple filter keep water available even when the supply is irregular.</p><p><b>Rustic-Modern Fusion:</b> Architectural balance using exposed wooden beams and raw stone accents paired with sleek, high-end contemporary finishes.</p><p><b>Biophilic Airiness:</b> Strategic use of floor-to-ceiling windows and skylights to flood the interior with natural light and provide sweeping views of the landscape.</p><p><b>Integrated Outdoor Living:</b> Designing sophisticated patios, verandas, and outdoor kitchens that serve as a natural extension of your indoor comfort.</p>\n            </div>\n            <div class=\"service-card full-width\">\n                <h3>From Plot to Finished Farmhouse</h3>\n                <p>Our first trip to the farm is mostly about looking: where the borewell is, how the land drains, which trees give shade and what can be saved from any old building. With that in hand, the farmhouse interior designer on our team draws a site plan, the house layout and a few 3D views to settle the look.</p><p>Construction, interiors and outdoor work then run on one schedule, with a short report after every site visit so you are not driving out every few days.</p>\n            </div>\n        </div>\n\n        <!-- WHY CHOOSE US -->\n        <section class=\"why-choose-us\">\n            <h2>A Farmhouse Interior Designer Who Knows the North Delhi Belt</h2>\n            <div class=\"why-choose-intro\">\n                <p>Farmhouse projects are usually managed from the city. We act as your eyes and hands on site, and call you only when a real decision is needed.</p>\n            </div>\n            <ul class=\"reason-list\">\n                <li>\n                    <strong>Bespoke Expertise in Luxury Countryside & Farmhouse Architecture</strong>\n                    Experience with country homes and function lawns.\n                </li>\n                <li>\n                    <strong>Customized Narratives Based on Your Lifestyle & Aesthetic Goals</strong>\n                    Spaces planned around family visits and events.\n                </li>\n                <li>\n                    <strong>Seamless End-to-End Project Management and Technical Execution</strong>\n                    Management of construction, interiors and outdoors.\n                </li>\n                <li>\n                    <strong>Secure When Empty</strong>\n                    Locks, lights and storage for weekday absence.\n                </li>\n                <li>\n                    <strong>Ready for Functions</strong>\n                    Lawns and utilities planned for events.\n                </li>\n            </ul>\n            <div class=\"final-cta-message\">\n                <p>Ready to escape the ordinary? Partner with Pitampura's leading farmhouse interior designer to build your ultimate retreat.</p>\n            </div>\n        </section>\n\n        <!-- WORK DONE / PORTFOLIO SHOWCASE -->\n        <section class=\"work-gallery-section\">\n            <div class=\"gallery-header\">\n                <h2>Our Completed Projects Near Pitampura</h2>\n                <p>Our finishing standard, seen in city homes in Ashok Vihar and Model Town.</p>\n            </div>\n            <div class=\"gallery-carousel-wrapper\">\n                <div class=\"gallery-carousel-track\">\n                    <div class=\"gallery-carousel-group\">\n                        <div class=\"gallery-card\">\n                            <div class=\"gallery-img-wrap\">\n                                <img width=\"800\" height=\"550\" decoding=\"async\" loading=\"lazy\" src=\"/img/project/mr-arun-ashok-vihar/mr-arun-ashok-vihar/5.avif\" alt=\"Bedroom design in Ashok Vihar, Delhi by 9th Corner\" title=\"Ashok Vihar Bedroom\">\n                            </div>\n                        </div>\n                        <div class=\"gallery-card\">\n                            <div clas