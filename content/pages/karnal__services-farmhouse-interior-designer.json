iv>\n        </section>\n        <!-- /FAQS:auto -->\n\n        <!-- CLOSING SECTION -->\n        <div class=\"closing-section\">\n            <h2>A Farmhouse That Fits Your Life</h2>\n            <p>Whether it is a working farm or a weekend retreat, your farmhouse should be easy to live in. An experienced farmhouse interior designer makes sure every part of it earns its place.</p><p>Own a farm near Karnal? <a href=\"/karnal/contact\">Invite 9th Corner to visit</a>.</p>\n        </div>\n\n    </div>\n"}